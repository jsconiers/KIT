{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit shared record: demand-rollup",
  "description": "Counts and a short list of the demands and tickets in one project, from the demand tracker's register. 1.1 adds optional kind, stage, and opened per item, for the team load view.",
  "x-kit-version": "1.1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "schema": {
      "const": "demand-rollup"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "total",
        "open",
        "by_status",
        "items"
      ],
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "title",
              "status",
              "role",
              "due",
              "open"
            ],
            "properties": {
              "number": {
                "type": "string",
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "maxLength": 160
              },
              "status": {
                "type": "string",
                "maxLength": 40
              },
              "role": {
                "type": "string",
                "maxLength": 60
              },
              "due": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "open": {
                "type": "boolean"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "demand",
                  "ia",
                  "gds",
                  "poc",
                  "other"
                ]
              },
              "stage": {
                "type": "string",
                "maxLength": 40
              },
              "opened": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
