{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit shared record: expertise",
  "description": "Topics the owner (by role) declares experience in, with a self-declared level and links to evidence records. Published only when the owner turns on expertise in sharing.md.",
  "x-kit-version": "1.0",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "schema": {
      "const": "expertise"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "topics"
      ],
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "topics": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "level"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "level": {
                "type": "string",
                "enum": [
                  "aware",
                  "working",
                  "expert"
                ]
              },
              "evidence": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    }
  }
}
