# Kit's run settings. Copy to ~/Claude/Agents/kit/.install/shared/morning/config and edit.
OWNER_NAME="Alex"

# How the morning brief and weekly review reach you (shared/deliver.py), space-separated, any of:
#   local           desktop notification with the first lines, plus a dashboard rebuild (default)
#   outlook-drafts  save the brief as a draft in Outlook's Drafts folder, addressed to
#                   DELIVERY_EMAIL_TO, with no window and no send; falls back to local if Outlook
#                   isn't running
#   outlook-review  the same draft, opened in a window for you to review; never sent
#   imessage        LEGACY, macOS only: texts the short version to IMESSAGE_TO. Leaves Microsoft
#                   365, so never use it for work content.
#   sms             LEGACY, Windows only: SMS gateway hook (a stub). Leaves Microsoft 365, so never
#                   use it for work content.
# Kit never sends mail: the Outlook channels only save or open a draft.
# Change these with kit-settings (run it with no arguments to see the current choices).
DELIVERY="local"
# Optional: deliver work and personal items differently. When either is set, it replaces DELIVERY:
# personal items (untagged to-dos, pastoral care, trading) go to DELIVERY_PERSONAL and work items
# (to-dos tagged [work], work meetings and mail) to DELIVERY_WORK, each as its own short text.
#   kit-settings delivery personal imessage     kit-settings delivery work outlook-drafts
#DELIVERY_PERSONAL="imessage"
#DELIVERY_WORK="outlook-drafts"
# Address the Outlook drafts are made out to (usually your own work address).
DELIVERY_EMAIL_TO="you@example.com"

# Legacy imessage channel only: where Kit texts the briefs. It tries these in order.
IMESSAGE_TO="+15555550123"
IMESSAGE_TO_ALT="you@example.com"

# Text Kit back (macOS): kit-textback answers texts you send yourself that start with "Kit" ("kit
# today", "kit todo call the bank fri", or any question). Its reader, KitMessages.app (build it with
# platform/mac/textback/build.sh), needs Full Disk Access; its job is com.<you>.kit.textback (from
# com.USER.kit.textback.plist.template). Replies go to IMESSAGE_TO. Questions use Claude, read-only.
TEXTBACK="off"
TEXTBACK_ASK="on"
TEXTBACK_MODEL="sonnet"
# The model that reads a date or an event out of a text ("kit event lunch Friday 12:30"): quick and cheap.
TEXTBACK_PARSE_MODEL="haiku"
TEXTBACK_MAX_PER_HOUR=30

# A run of your own: put its prompt in .install/prompts/prompt-NAME.md, schedule
# "run.sh NAME", and give it extra tools with ALLOW_TOOLS_<NAME> (permission rules separated by
# semicolons, like ALLOW_TOOLS). Executables in .install/brief.d/ add sections to the brief.

# To-do sync backend: outlook (Outlook Tasks, the default on macOS and Windows) or apple
# (Apple Reminders, macOS only; syncs through iCloud, so keep work items out of it).
REMINDERS_BACKEND="outlook"
# Optional: keep work and personal to-dos in different apps (macOS). Work to-dos are the ones tagged
# [work] (todo work ...); each app gets its own "Kit Inbox" and "Kit: <name>" lists.
#   kit-settings todos personal apple     kit-settings todos work outlook
#TODOS_PERSONAL="apple"
#TODOS_WORK="outlook"

# Days with no morning or open run (date +%u: 1 = Monday ... 7 = Sunday), space-separated.
SKIP_DAYS=""
# Tools the unattended runs may never call, space-separated.
BLOCK_TOOLS=""
# Extra tools the unattended runs may use, as Claude Code permission rules separated by semicolons
# (rules can contain spaces), for example the read-only mail and calendar commands your setup files
# name. Leave empty for none.
ALLOW_TOOLS=""
# More tools for the weekly review only (semicolon-separated), for example "Agent" for the auditor.
ALLOW_TOOLS_WEEKLY=""

# Weekly demand refresh: in the Monday weekly review, the demand tracker re-checks the demands in its
# register through its connector (read-only, under its connector-guard hooks, one get per demand),
# records what changed in REGISTER.md and LOG.md, and the review gets a "Demands: what changed"
# section. Leave it "off" until a connector is set up. DEMAND_SERVER is the connector (MCP server)
# name, which must also be in connector-guard.json's allowed_servers. DEMAND_TOOLS lists the read
# tools the run may call, as full names (mcp__<server>__<tool>) separated by semicolons; empty takes
# that server's entries in connector-guard.json's allow_tools. Only tools the guard would allow are
# used. DEMAND_REGISTER_DIR is the folder holding REGISTER.md and LOG.md (the register's place from
# demands.md, under the library root). It's skipped, with a line in the review, at the budget's stop
# level or when fewer than DEMAND_REFRESH_MIN_LEFT minutes of the run are left; DEMAND_REFRESH_MAX
# caps the demands checked in one run.
DEMAND_REFRESH="off"
DEMAND_SERVER=""
DEMAND_TOOLS=""
DEMAND_REGISTER_DIR=""
DEMAND_REFRESH_MAX="25"
DEMAND_REFRESH_MIN_LEFT="10"
# Monthly regulatory watch: on the first weekly review of each month (the first Monday), the
# researcher writes a brief on last month's public changes to the regimes and topics in
# compliance.md's "Regulatory watch" field (for example "SEC Reg SCI, CFTC, DORA, NYDFS 500, NIST"),
# from public sources only, each cited, from regulatory-watch-template.md. It's saved in the
# "Regulatory watch folder" from compliance.md (default regulatory-watch/ in the library root), and
# the review gets a three-line summary. Only when it's on and due does the run allow the Agent,
# WebSearch, and WebFetch tools for it. It's skipped, with a line in the review, when the regimes
# aren't set, at the budget's warning or stop level, or when the run has less than REG_WATCH_MIN_LEFT
# minutes left. REG_WATCH_WHEN="every-run" runs it on every weekly review (for a test).
REG_WATCH="off"
REG_WATCH_WHEN="first-monday"
REG_WATCH_MIN_LEFT="15"
# Optional: a command that prints today's events as a JSON list, for the dashboard's Today panel
# (fields start, end, all_day, title or subject, calendar). Empty uses the macOS kitcal tool.
CALENDAR_JSON_CMD=""

# Backups (kit-backup): where archives go and how many to keep. Choose an approved location;
# the default folder sits next to Kit on the same disk, which doesn't survive a lost computer.
BACKUP_DIR=""
BACKUP_KEEP="14"
# Encrypt backups (on/off). The passphrase comes from a macOS Keychain entry or an environment
# variable, named here, never the passphrase itself. Create the Keychain entry yourself:
#   security add-generic-password -s kit-backup -a "$USER" -w
# Unencrypted backups are refused outside your home folder or in a synced or shared folder.
BACKUP_ENCRYPT="off"
BACKUP_KEY_KEYCHAIN=""
BACKUP_KEY_ENV=""

# Outlook check before the morning brief and weekly review (kit-outlook): seconds to wait between
# retries, and "off" to skip it on setups without Outlook.
OUTLOOK_RETRY_WAITS="30 90"
OUTLOOK_CHECK="on"

# Connector check before the morning brief (kit-connect test, with no read call, so no model cost):
# one PASS/FAIL line per connector at the top of the brief. Seconds before it gives up, and "off"
# to skip it. It never fails the run.
CONNECTOR_CHECK="on"
CONNECTOR_CHECK_TIMEOUT="120"
# Outage alert: when a connector fails this many mornings running, Kit adds one [work] item to your
# list ("Fix connector <name>, failing since ...") and the dashboard shows a red Connector outage
# banner. Both are raised once per outage; when the check passes again the item gets a "Recovered"
# line (you check it off) and the banner clears. History: briefs/connectors-history.jsonl.
CONNECTOR_FAIL_STREAK="2"

# Cost (kit-cost): every scheduled run records its estimated cost in .install/logs/cost.jsonl.
# COST_BUDGET_MONTHLY is the monthly budget for scheduled runs in US dollars (empty: no budget, no
# run is ever skipped). From COST_WARN_PCT the brief says how much is used; from COST_STOP_PCT only
# the run kinds in COST_ESSENTIAL_MODES go ahead. Interactive sessions aren't counted.
COST_BUDGET_MONTHLY=""
COST_WARN_PCT="80"
COST_STOP_PCT="95"
COST_ESSENTIAL_MODES="morning"
# Cost alerts (run_alerts.py, at the end of every scheduled run; kit-alerts shows them). With a budget:
# one [work] item for you and a red Cost banner when the month's projection reaches
# COST_ALERT_PROJECTION x the budget (a fraction such as 0.9; empty: COST_WARN_PCT of it), cleared
# when it falls back under, and another when spend reaches COST_STOP_PCT (runs are being skipped),
# cleared when the month ends. With no budget: an alert when one day costs more than
# COST_SPIKE_FACTOR times the median day of the 14 before it. Each at most once a month.
COST_ALERT_PROJECTION=""
COST_SPIKE_FACTOR="3"

# Degraded mode: at the budget's stop level, and when the morning model run fails or times out,
# kit-degraded writes the brief from Kit's files with no model call, so a brief still arrives.
# Set "off" for the old behaviour: the morning run still calls the model at the stop level, and a
# failed run sends only a failure notice.
DEGRADED_MODE="on"

# Time limits for scheduled runs, in seconds (weekly review 3000, work list 900, others 1200), and
# how long a run waits for another to finish before going ahead anyway (1800).
RUN_TIMEOUT=""
RUN_TIMEOUT_WEEKLY=""
RUN_TIMEOUT_WORKLIST=""
RUN_LOCK_WAIT=""

# End-of-day wrap-up (run.sh eod, weekdays 17:30 when its launchd job is installed): "on" or "off".
EOD="on"

# Phone and remote access, phase 1 (shared/kit_inbox.py). PHONE_APPROVALS adds a single-use code to
# each delivered work list and brief for approving it from Kit Inbox (low-tier actions only).
# ONEDRIVE_PUBLISH_DIR publishes the brief and a work summary page to a folder inside your
# OneDrive for reading on the phone (empty = off); ONEDRIVE_ALLOWED_PREFIX allows another root.
# PUBLISH_PERSONAL="on" includes personal items and a copy of the full dashboard.
PHONE_APPROVALS="on"
ONEDRIVE_PUBLISH_DIR=""
ONEDRIVE_ALLOWED_PREFIX=""
PUBLISH_PERSONAL="off"

# Auto-retry: one retry, after RETRY_DELAY seconds, when a scheduled run fails in a way that looks
# transient (overload, rate limit, network, an API 5xx or 529). Never after a timeout or a refusal.
RETRY_ON="on"
RETRY_DELAY="120"

# Reliability alerts (kit-reliability): warn when a run type's success rate over 30 days drops below
# this percentage.
RELIABILITY_MIN_PCT="90"

# Failed-run alerts (run_alerts.py, at the end of every scheduled run and before the morning brief
# and weekly review; kit-alerts shows and recomputes them). When a run type (morning, weekly,
# worklist, eod, open, journal, backup, sync) fails RUN_FAIL_STREAK times in a row, or hasn't
# succeeded within its window, Kit adds one [work] item to your list ("Fix Kit's <run> run, failing
# since ..."), the dashboard shows a red Scheduled run banner, and the brief names it; the next
# success clears it with a "Recovered" line on the item. Windows: RUN_WINDOW_MORNING in weekdays
# (SKIP_DAYS don't count), RUN_WINDOW_SYNC in hours, the others in days; "off" (or empty, for
# worklist, eod, open, and journal) means no window. RUN_ALERTS="off" turns all of this, and the cost
# alerts, off; RUN_ALERTS_TIMEOUT is the seconds it may take before it's stopped.
RUN_ALERTS="on"
RUN_ALERTS_TIMEOUT="60"
RUN_FAIL_STREAK="2"
RUN_WINDOW_MORNING="2"
RUN_WINDOW_WEEKLY="8"
RUN_WINDOW_SYNC="2"
RUN_WINDOW_BACKUP="2"
RUN_WINDOW_WORKLIST=""
RUN_WINDOW_EOD=""

# Monitors (run_alerts.py, with the run and cost alerts; kit-alerts shows them, --only drift|library|
# waiting|guard). Each is "on" or "off" ("off" clears what it had open); MONITOR_TIMEOUT is the seconds each
# may take (a check that runs out of time leaves its alerts as they were). Read-only; never fails a run.
# Drift: an agent whose live copy (agents/) differs from the shipped one (.install/kit/agents/) once the
# owner name and the model line are set aside, or a live agent out of date in ~/.claude/agents: one
# [work] item per kind of drift; compare with kit-alerts drift --diff <agent> (nothing is overwritten).
MONITOR_DRIFT="on"
# Library: the published folders named in memory/context/library.md against their indexes. An alert,
# and one [work] item asking the librarian to reindex, when more than LIBRARY_UNINDEXED_MAX files aren't
# in the index (0: any), an indexed file is gone, or the index is older than LIBRARY_INDEX_MAX_DAYS
# while files changed after it. When the library root is in a cloud-synced folder: an inferred "sync
# may be stalled" alert (brief and banner only) when the published folders haven't changed in
# LIBRARY_SYNC_MAX_DAYS while Kit wrote to the library in that time ("0": off).
MONITOR_LIBRARY="on"
LIBRARY_UNINDEXED_MAX="0"
LIBRARY_INDEX_MAX_DAYS="30"
LIBRARY_SYNC_MAX_DAYS="14"
# Waiting: "Waiting on others" items, and your own Approve/Decide/"decide by" items, whose latest date
# (added, updated, or since) is more than WAITING_MAX_DAYS old. Waiting-on-others items get a follow-up
# draft in briefs/followups/ (never sent); no queue item. Clears when the item is checked off or updated.
MONITOR_WAITING="on"
WAITING_MAX_DAYS="7"
# Guard: connector-guard integrity. The installed copies (~/.claude/agents) of the agents shipped with
# guard hooks still run pre, post, and fail against an existing connector-guard script; connector-guard.json
# is readable; with connectors configured, its audit_dir exists and is writable (a probe file is created
# and removed); and allowed calls older than GUARD_NORESULT_HOURS (empty: open_session_hours in audit.md,
# else 2) in the last GUARD_WINDOW_DAYS have a result record. One alert and one [work] item per outage.
MONITOR_GUARD="on"
# Policy exception register (kit-exceptions): alert on expired, soon-expiring (EXCEPTIONS_WARN_DAYS), and
# overdue reviews. Needs compliance.md's Exception register field (or the default location).
MONITOR_EXCEPTIONS="on"
EXCEPTIONS_WARN_DAYS="30"
GUARD_NORESULT_HOURS=""
GUARD_WINDOW_DAYS="2"
MONITOR_TIMEOUT="20"
# Login check (platform/mac/morning/preflight.sh; Windows preflight.ps1), daily 06:45 and 15:45: checks
# that Claude Code can run and that these connectors (space-separated `claude mcp` names, for servers that
# sign in with OAuth) are signed in, and tells you once per lapse.
PREFLIGHT_CONNECTORS=""
# Connection check before each run's model call ("on"/"off"), and how many seconds to wait for the
# network before skipping the model run.
CONNECTION_CHECK="on"
CONNECTION_WAIT="300"
