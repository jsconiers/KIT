# The standalone PPM Express MCP server, for OpenShift. Build it from the repository root (on macOS, Linux,
# or Windows, with podman or docker):
#
#   podman build -f shared/ppmx/Containerfile -t ppmx-mcp:0.2.0 .
#
# It runs as whatever non-root user OpenShift assigns (group 0), with a read-only filesystem: the code is
# group-readable and nothing is written outside /tmp and /dev/shm. Use your organization's approved base
# image if it has one: --build-arg BASE_IMAGE=..., ideally pinned by digest; and its package mirror if pip
# can't reach PyPI: --build-arg PIP_INDEX_URL=https://.../simple. openshift/INSTALL.md has the steps.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/python-312:latest
FROM ${BASE_IMAGE}
ARG PIP_INDEX_URL=""

USER 0
WORKDIR /opt/ppmx
COPY shared/ppmx/requirements.txt /opt/ppmx/requirements.txt
RUN python3 -m pip install --no-cache-dir ${PIP_INDEX_URL:+--index-url "$PIP_INDEX_URL"} \
      -r /opt/ppmx/requirements.txt
COPY shared/ppmx/ /opt/ppmx/ppmx/
RUN rm -rf /opt/ppmx/ppmx/openshift /opt/ppmx/ppmx/Containerfile /opt/ppmx/ppmx/__pycache__ \
 && chgrp -R 0 /opt/ppmx && chmod -R g=u,o-w /opt/ppmx

ENV PYTHONUTF8=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/ppmx
USER 1001
EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--threads", "4", "--timeout", "60", \
     "--worker-tmp-dir", "/dev/shm", "--no-control-socket", "--chdir", "/opt/ppmx", \
     "ppmx.server_http:application"]
