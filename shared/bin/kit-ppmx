#!/usr/bin/env python3
"""kit-ppmx: PPM Express from Claude Code or Claude Desktop: read projects, tasks, key dates, and ideas,
and create or update them, each change approved by you.

  kit-ppmx serve              the MCP server on standard input and output; Claude Code or Claude Desktop
                              starts it (kit-ppmx setup gives the commands)
  kit-ppmx check              whose token it is in PPM Express, its scopes (can it make changes?), and
                              when it expires; exit 0 when PPM Express answers
  kit-ppmx tools              the tools it offers, the ones that change PPM Express marked
  kit-ppmx call TOOL [JSON]   run one tool and print the result, for testing (a create_ or update_ tool
                              changes PPM Express); Claude Code asks before it runs this
  kit-ppmx desktop            add Kit's PPM Express server to Claude Desktop's config, after a backup
                              (--remove takes it out; --print shows the entry and changes nothing)
  kit-ppmx setup              the steps for this computer: the token, the address, Claude Code, Claude
                              Desktop, and Kit's connector guard. It changes nothing.
  kit-ppmx pulse [--save] [--brief] [--json] [--scope all|mine|"NAME,NAME"] [--since YYYY-MM-DD]
                              the portfolio pulse: projects that turned At Risk or Critical, key dates that
                              slipped, are overdue, or come due in 14 days, and what else changed since last
                              week's snapshot (--save keeps this week's in briefs/ppmx/). Read only. On
                              Mondays the morning brief has it when PPMX_PULSE="on"
  kit-ppmx actions [FILE] [--project ID|NAME]
                              meeting actions into PPM Express: from minutes (or briefs/pending-actions.md),
                              propose a task to create or update for each action, and save the proposals.
                              Read only
  kit-ppmx actions apply N    make proposal N, and only it; Claude Code asks first (show lists them; map
                              SLUG PROJECT says which PPM Express project a library project is)

Works on macOS and Windows. Settings: PPMX_BASE_URL (https://<host>/@<tenant>/v1.0, from PPM Express >
Automation) and the other PPMX_* settings in shared/ppmx/README.md, from the environment or Kit's config
(~/Claude/Agents/kit/.install/shared/morning/config); PPMX_WRITES="off" there makes it read-only. The
personal access token: the environment variable PPMX_TOKEN (PPMX_TOKEN_ENV names another), or the Mac
Keychain or Windows Credential Manager entry PPMX_TOKEN (PPMX_TOKEN_KEYCHAIN names another, or "off").
It's never written to a file, printed, or logged, and a token in Kit's config is ignored.

Changes: in Claude Code, Kit's permission rules make every create or update ask you first, and scheduled
runs and Kit's agents never make one (the connector guard stops the agents). Claude Desktop asks before a
tool runs unless you've told it to always allow that tool. Every tool call is recorded, without its
values, in Kit's audit folder (ppmx-YYYY-MM.jsonl) and on standard error.

Exit codes: 0 fine, 1 PPM Express refused or failed, 2 not set up (no address or no token) or bad input.
"""
import argparse
import datetime
import json
import os
import pathlib
import re
import sys
import urllib.parse

SHARED = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(SHARED))
import kit_secrets  # noqa: E402
from ppmx import __version__  # noqa: E402
from ppmx.client import Client, token_key  # noqa: E402
from ppmx.codes import CodesError, load as load_codes  # noqa: E402
from ppmx.config import Settings  # noqa: E402
from ppmx.mcp_core import Dispatcher  # noqa: E402
from ppmx.server_stdio import serve  # noqa: E402
from ppmx import actions as actions_mod  # noqa: E402
from ppmx import pulse as pulse_mod  # noqa: E402
from ppmx.client import PPMXError  # noqa: E402
from ppmx.tools import TOOLS, Context, ToolError, t_current_user  # noqa: E402

KIT = pathlib.Path(os.path.expanduser(os.environ.get("KIT_DIR", "~/Claude/Agents/kit")))
CONFIG = KIT / ".install/shared/morning/config"
GUARD = KIT / "memory/context/connector-guard.json"
SETTING = re.compile(r"^\s*(?:export\s+)?(PPMX_[A-Z_]+)\s*=(.*)$")
WINDOWS = os.name == "nt"
WORK_DIR = KIT / "briefs" / "ppmx"                       # pulse snapshots and action proposals (owner-only)
PROJECT_MAP = KIT / "memory/context/ppmx-projects.json"  # library project slug -> PPM Express project
KEEP_DAYS = 120
STORE = "Credential Manager entry" if WINDOWS else "Keychain entry"


def shell_value(raw):
    """A value as the shell reads it from a config line: "x", 'x', or x, with any # comment after it.
    None when it can't be read (an unclosed quote)."""
    raw = raw.strip()
    if raw[:1] in ("'", '"'):
        end = raw.find(raw[0], 1)
        return raw[1:end] if end > 0 else None
    return re.split(r"\s#", raw, maxsplit=1)[0].strip()


def kit_env():
    """The environment, plus PPMX_* settings from Kit's config where the environment has none. A token
    there is ignored: tokens live in the environment or the credential store, never in a file. A
    PPMX_WRITES line Kit can't read counts as "off", so a typo never turns changes on."""
    env = dict(os.environ)
    try:
        text = CONFIG.read_text(encoding="utf-8-sig")
    except OSError:
        text = ""
    for line in text.splitlines():
        m = SETTING.match(line)
        if not m or m.group(1).endswith("TOKEN") or (env.get(m.group(1)) or "").strip():
            continue
        value = shell_value(m.group(2))
        if value is None:
            value = "off" if m.group(1) == "PPMX_WRITES" else ""
        env[m.group(1)] = value
    return env


def token_places(env):
    """(environment variable, credential store entry or None) the token is read from: the Mac Keychain
    or Windows Credential Manager. PPMX_TOKEN_KEYCHAIN names a different entry, or "off" for none."""
    entry = (env.get("PPMX_TOKEN_KEYCHAIN") or "PPMX_TOKEN").strip()
    if not (sys.platform == "darwin" or WINDOWS) or entry.lower() in ("off", "none", "no"):
        entry = None
    return (env.get("PPMX_TOKEN_ENV") or "PPMX_TOKEN").strip(), entry


def get_token(env):
    """(token, problem): the token, or "" and what to do about it."""
    var, entry = token_places(env)
    if (os.environ.get(var) or "").strip():
        return os.environ[var].strip(), ""
    if entry:
        try:
            cred = kit_secrets.resolve({"credential_env": var, "keychain_entry": entry}, "PPM Express")
            if cred:
                return cred.reveal().strip(), ""
        except kit_secrets.CredentialError:
            pass
    where = f"the environment variable {var}" + (f" or the {STORE} {entry}" if entry else "")
    return "", f"No personal access token: set {where} (kit-ppmx setup shows how)."


def tables_for(settings):
    try:
        return load_codes(settings.codes_file)
    except CodesError as e:
        print(f"kit-ppmx: {e}; coded fields stay as numbers", file=sys.stderr)
        return {}


def audit_folder():
    """Kit's audit folder: the connector guard's audit_dir, or ~/Claude/Agents/kit/audit."""
    try:
        folder = json.loads(GUARD.read_text(encoding="utf-8-sig")).get("audit_dir")
    except (OSError, ValueError, AttributeError):
        folder = None
    return pathlib.Path(os.path.expanduser(folder or str(KIT / "audit")))


def audit_logger(settings):
    """One JSON line per tool call (no token, no argument values) in <audit folder>/ppmx-YYYY-MM.jsonl,
    and on standard error, which Claude Code and Claude Desktop keep in their MCP logs."""
    folder = audit_folder()

    def log(entry):
        line = json.dumps(entry, ensure_ascii=False, default=str)
        if settings.audit:
            sys.stderr.write(line + "\n")
            sys.stderr.flush()
        try:
            folder.mkdir(mode=0o700, parents=True, exist_ok=True)
            with open(folder / f"ppmx-{datetime.date.today():%Y-%m}.jsonl", "a", encoding="utf-8") as f:
                f.write(line + "\n")
        except OSError:
            pass                                      # the call goes ahead; standard error still has it

    return log


def dispatcher_for(settings, tables, client, hint):
    return Dispatcher(lambda token: Context(client, settings, tables, token, hint=hint()), writes=settings.writes)


def cmd_serve(env):
    settings = Settings(env)
    client, tables = Client(settings), tables_for(settings)
    state = {"hint": ""}

    def token_source():
        token, state["hint"] = get_token(env)
        return token

    return serve(dispatcher_for(settings, tables, client, lambda: state["hint"]), token_source,
                 log=audit_logger(settings))


def ready(env):
    """(settings, token) when both are usable; otherwise prints why and returns None."""
    settings = Settings(env)
    if not settings.ready:
        print(f"kit-ppmx: {settings.problem}", file=sys.stderr)
        return None
    token, problem = get_token(env)
    if not token:
        print(f"kit-ppmx: {problem}", file=sys.stderr)
        return None
    return settings, token


def call(settings, token, name, args, tables=None, via="kit-ppmx call"):
    """(ok, text): one tool run the way the MCP server runs it, recorded in the audit log."""
    d = dispatcher_for(settings, {} if tables is None else tables, Client(settings), lambda: "")
    facts = {}
    reply = d.handle({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": name, "arguments": args}},
                     token, facts.update)
    if facts.get("tool"):
        audit_logger(settings)({"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                                "via": via, "user": f"u:{token_key(token)[:12]}", **facts})
    if "error" in reply:
        return False, reply["error"]["message"]
    res = reply["result"]
    return not res["isError"], res["content"][0]["text"]


def cmd_check(env):
    got = ready(env)
    if not got:
        return 2
    settings, token = got
    good, text = call(settings, token, "get_current_user", {}, via="kit-ppmx check")
    if not good:
        print(f"kit-ppmx: {text}", file=sys.stderr)
        return 1
    me = json.loads(text)
    who = me.get("displayName") or me.get("name") or me.get("logonAccount") or "(no name given)"
    host = urllib.parse.urlsplit(settings.base_url).hostname
    print(f"kit-ppmx: PPM Express answers at {host}: {who}" + (f" <{me['email']}>" if me.get("email") else ""))
    tok = me.get("token") or {}
    scopes = [str(s) for s in tok.get("scopes") or []]
    print(f"  token: {tok.get('name') or '(unnamed)'}, expires {when(tok.get('expirationDate'))}; "
          f"scopes: {', '.join(scopes) if scopes else 'none listed'}")
    can_write = any(re.search(r"(?i)\b(write|create|update|manage)\b", s) for s in scopes)
    if not settings.writes:
        print("  changes: off (PPMX_WRITES=off): Kit only reads")
    elif can_write:
        print("  changes: the token's scopes allow them; Claude Code asks before each one")
    else:
        print("  changes: the token has no write scopes, so PPM Express will refuse them; reading works")
    expires = day(tok.get("expirationDate"))
    if expires and expires - datetime.date.today() <= datetime.timedelta(days=14):
        print(f"  note: the token expires {'today' if expires <= datetime.date.today() else 'within two weeks'}; "
              "create a new one in PPM Express > Automation")
    return 0


def day(value):
    try:
        return datetime.date.fromisoformat(str(value)[:10])
    except ValueError:
        return None


def when(value):
    d = day(value)
    return d.strftime("%d-%b-%Y") if d else "(not given)"


def cmd_tools():
    for t in TOOLS:
        mark = "" if t["kind"] == "read" else " [changes PPM Express]"
        print(f"{t['name']:<18} {t['description'].split(' Changes PPM Express:')[0]}{mark}")
    return 0


def cmd_call(env, name, raw):
    try:
        args = json.loads(raw) if raw else {}
    except ValueError:
        print("kit-ppmx: the arguments must be JSON, like '{\"limit\": 5}'", file=sys.stderr)
        return 2
    if not isinstance(args, dict):
        print("kit-ppmx: the arguments must be a JSON object", file=sys.stderr)
        return 2
    got = ready(env)
    if not got:
        return 2
    settings, token = got
    good, text = call(settings, token, name, args, tables_for(settings))
    if not good:
        print(f"kit-ppmx: {text}", file=sys.stderr)
        return 1
    print(json.dumps(json.loads(text), indent=2, ensure_ascii=False))
    return 0


# ---------------------------------------------------------------- Claude Desktop

def desktop_config():
    """Claude Desktop's config file on this computer, or None where Desktop doesn't run.
    CLAUDE_DESKTOP_CONFIG names another file (tests use it)."""
    override = (os.environ.get("CLAUDE_DESKTOP_CONFIG") or "").strip()
    if override:
        return pathlib.Path(os.path.expanduser(override))
    if sys.platform == "darwin":
        return pathlib.Path.home() / "Library/Application Support/Claude/claude_desktop_config.json"
    if WINDOWS and os.environ.get("APPDATA"):
        return pathlib.Path(os.environ["APPDATA"]) / "Claude" / "claude_desktop_config.json"
    return None


def desktop_entry():
    """How Claude Desktop starts the server: this Python, this script, serve. No token in it."""
    return {"command": sys.executable or "python3", "args": [str(pathlib.Path(__file__).resolve()), "serve"],
            "env": {"PYTHONUTF8": "1"}}


def backup(path):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    if (KIT / ".install").is_dir():
        folder = KIT / ".install/backups" / f"{stamp}-claude-desktop"
        folder.mkdir(parents=True, exist_ok=True)
        dest = folder / path.name
    else:
        dest = path.with_name(f"{path.name}.bak-{stamp}")
    dest.write_bytes(path.read_bytes())
    return dest


def cmd_desktop(env, remove=False, show=False):
    path, entry = desktop_config(), desktop_entry()
    if show or path is None:
        if path is None:
            print("kit-ppmx: Claude Desktop runs on macOS and Windows; to use this server from another app, "
                  "give it this:", file=sys.stderr)
        print(json.dumps({"mcpServers": {"ppmx": entry}}, indent=2))
        return 0 if show else 2
    try:
        text = path.read_text(encoding="utf-8-sig") if path.exists() else ""
        data = json.loads(text) if text.strip() else {}
    except (OSError, ValueError):
        print(f"kit-ppmx: {path} isn't valid JSON, so it was left as it is; fix it (Claude Desktop > Settings > "
              "Developer > Edit Config) and run this again", file=sys.stderr)
        return 2
    if not isinstance(data, dict) or not isinstance(data.get("mcpServers", {}), dict):
        print(f"kit-ppmx: {path} doesn't look like Claude Desktop's config, so it was left as it is", file=sys.stderr)
        return 2
    servers = data.setdefault("mcpServers", {})
    if remove:
        if "ppmx" not in servers:
            print("kit-ppmx: Claude Desktop has no ppmx server; nothing to take out")
            return 0
        del servers["ppmx"]
    elif servers.get("ppmx") == entry:
        print(f"kit-ppmx: Claude Desktop already has Kit's PPM Express server ({path})")
        return 0
    else:
        servers["ppmx"] = entry
    saved = backup(path) if text else None
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".kit-tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(str(tmp), str(path))
    print(f"kit-ppmx: {'took Kit' if remove else 'added Kit'}'s PPM Express server "
          f"{'out of' if remove else 'to'} Claude Desktop's config: {path}")
    if saved:
        print(f"  the earlier config is saved at {saved}")
    print("  Quit Claude Desktop and open it again to load the change.")
    if not remove:
        var, store = token_places(env)
        print(f"  Desktop doesn't see variables set in a terminal: keep the token in the {STORE} {store}"
              if store else f"  Desktop must be able to see the environment variable {var}")
    return 0


# ---------------------------------------------------------------- setup

def cmd_setup(env):
    me = pathlib.Path(__file__).resolve()
    py = sys.executable or "python3"
    var, entry = token_places(env)
    settings = Settings(env)
    status = "set" if settings.ready else f"not usable yet: {settings.problem}"
    token = "found" if get_token(env)[0] else "not found yet"
    if WINDOWS and entry:
        where = f"in Windows Credential Manager as {entry}"
        store = [f"     cmdkey /generic:{entry} /user:kit /pass",
                 "   It asks for the token, so it never lands in your shell history. (A user environment",
                 f"   variable {var} works too, for Claude Desktop only if it's set before Desktop starts.)"]
    elif entry:
        where = f"in the Keychain as {entry}"
        store = [f'     security add-generic-password -s {entry} -a "$USER" -w',
                 "   It asks for the token, so it never lands in your shell history."]
    else:
        where = f"in the environment variable {var}"
        store = [f"     read -rs {var} && export {var}    (it asks without echoing; add it to your session's secrets)"]
    writes = ("Changes are on: PPMX_WRITES=\"off\" there makes it read-only." if settings.writes
              else "Changes are off (PPMX_WRITES=\"off\"): it only reads.")
    print(f"""Connect PPM Express to Kit on this computer (kit-ppmx {__version__}; this changes nothing).

1. A token (now: {token}). In PPM Express > Automation, create a personal access token: read scopes to
   look, and write scopes (such as Write Projects) for the changes you approve. Store it {where}:
{chr(10).join(store)}

2. The address (now: {status}). In Kit's config, {CONFIG}, add
     PPMX_BASE_URL="https://<host>/@<tenant>/v1.0"
   with your tenant's API address from PPM Express > Automation. {writes}

3. Claude Code. Add the server for your user:
     claude mcp add --scope user --env PYTHONUTF8=1 ppmx -- "{py}" "{me}" serve
   Kit's rules make Claude Code ask before every create or update (rerun Kit's installer to add them).

4. Claude Desktop, if you use it: run  kit-ppmx desktop  (it adds the same server to Desktop's config,
   after a backup), then quit and reopen Desktop. Desktop asks before a tool runs unless you've told it
   to always allow that tool; leave the create_ and update_ tools on asking.

5. Kit's connector guard, so Kit's agents can read PPM Express (they can never change it). In
   {GUARD}:
     "allowed_servers": [..., "ppmx"],
     "credential_env": {{"ppmx": ["{var}"]}},
     "probe_tools": {{"ppmx": "mcp__ppmx__get_current_user"}}
   and add PPM Express (connector ppmx) under Systems in connectors.md, next to it.

6. Check: kit-ppmx check, then kit-connect test ppmx (add --read for one call through the gateway).""")
    return 0


# ---------------------------------------------------------------- the portfolio pulse

def private_write(path, text):
    """Write a file only this account can read (snapshots and proposals hold work data)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    if not WINDOWS:
        os.chmod(path.parent, 0o700)
        os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def snapshots():
    """[(date, path)] of the saved pulse snapshots, oldest first."""
    out = []
    for f in WORK_DIR.glob("pulse-*.json") if WORK_DIR.is_dir() else []:
        try:
            out.append((datetime.date.fromisoformat(f.stem[6:]), f))
        except ValueError:
            pass
    return sorted(out)


def baseline(today, since=None):
    """The snapshot to compare with: the one from `since`, or the latest one at least six days old."""
    for d, f in reversed(snapshots()):
        if (since and d == since) or (not since and d <= today - datetime.timedelta(days=6)):
            try:
                return json.loads(f.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                return None
    return None


def my_names(ctx):
    try:
        me = t_current_user(ctx, {})
    except (PPMXError, ToolError):
        return []
    return [str(me[k]) for k in ("displayName", "name", "email", "logonAccount") if me.get(k)]


def cmd_pulse(env, argv):
    ap = argparse.ArgumentParser(prog="kit-ppmx pulse", description="The portfolio pulse (read only).")
    ap.add_argument("--save", action="store_true", help="keep this snapshot for next week's comparison")
    ap.add_argument("--brief", action="store_true", help="lines for the morning brief, tagged [work]")
    ap.add_argument("--json", action="store_true", help="the comparison as JSON")
    ap.add_argument("--scope", default=None, help='all (the default), mine, or portfolio and program names: "A,B"')
    ap.add_argument("--since", default=None, help="compare with the snapshot from this date (YYYY-MM-DD)")
    a = ap.parse_args(argv)
    title = "PPM Express pulse"

    def fail(why, rc):
        if a.brief:                                   # the brief says what went wrong instead of going quiet
            print(f"{title}\n[work] Couldn't read PPM Express: {why}")
            return 0
        print(f"kit-ppmx: {why}", file=sys.stderr)
        return rc
    since = None
    if a.since:
        try:
            since = datetime.date.fromisoformat(a.since)
        except ValueError:
            return fail("--since takes a date like 2026-11-02", 2)
        if since not in [d for d, _ in snapshots()]:
            return fail(f"there's no snapshot from {a.since}; the saved ones: "
                        + (", ".join(d.isoformat() for d, _ in snapshots()) or "none yet"), 2)
    settings = Settings(env)
    if not settings.ready:
        return fail(settings.problem, 2)
    token, problem = get_token(env)
    if not token:
        return fail(problem, 2)
    ctx = Context(Client(settings), settings, tables_for(settings), token)
    raw = (a.scope or env.get("PPMX_PULSE_SCOPE") or "all").strip()
    scope = raw.lower() if raw.lower() in ("all", "mine") else [s.strip() for s in raw.split(",") if s.strip()]
    me = my_names(ctx) if scope == "mine" else None
    try:
        snap = pulse_mod.snapshot(ctx, scope, me, max_projects=int(env.get("PPMX_PULSE_MAX") or 300),
                                  deadline_seconds=int(env.get("PPMX_PULSE_SECONDS") or 240),
                                  now=datetime.datetime.combine(ctx.today, datetime.datetime.now().time()))
    except PPMXError as e:
        return fail(str(e), 1)
    today = ctx.today
    rep = pulse_mod.compare(baseline(today, since), snap, today)
    audit_logger(settings)({"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                            "via": "kit-ppmx pulse", "user": f"u:{token_key(token)[:12]}", "tool": "pulse",
                            "outcome": "ok", "projects": rep["projects"], "key_dates": rep["key_dates"]})
    if a.save:
        private_write(WORK_DIR / f"pulse-{today.isoformat()}.json", json.dumps(snap, indent=1, ensure_ascii=False))
        for d, f in snapshots():
            if d < today - datetime.timedelta(days=KEEP_DAYS):
                f.unlink()
    if a.json:
        print(json.dumps(rep, indent=2, ensure_ascii=False))
    elif a.brief:
        print(title)
        print("\n".join(pulse_mod.lines(rep)))
    else:
        print(f"{title}, {pulse_mod.fmt_day(today.isoformat())}"
              + (f" (scope: {raw})" if raw.lower() != "all" else ""))
        print("\n".join("  " + ln for ln in pulse_mod.lines(rep, n=25, tag="")))
        if a.save:
            print(f"Saved this week's snapshot: briefs/ppmx/pulse-{today.isoformat()}.json")
    return 0


# ---------------------------------------------------------------- meeting actions into PPM Express

CURRENT = WORK_DIR / "actions-current"                  # the proposals file the last `kit-ppmx actions` made
TASK_TOOLS = {"create_task": {"project_id", "name", "fields"}, "update_task": {"project_id", "task_id", "fields"}}
UNCONFIRMED = ("couldn't confirm", "accepted the change but")


def proposal_files():
    return sorted(WORK_DIR.glob("actions-*.json"), key=lambda f: f.stat().st_mtime) if WORK_DIR.is_dir() else []


def load_proposals(name=None):
    """(path, data) for a proposals file (by name or path), or the one the last proposing run made."""
    if name:
        f = pathlib.Path(os.path.expanduser(name))
        if not f.is_file():
            f = WORK_DIR / (name if name.endswith(".json") else f"actions-{name}.json")
    else:
        current = CURRENT.read_text(encoding="utf-8").strip() if CURRENT.is_file() else ""
        f = WORK_DIR / current if current else None
        if not f or not f.is_file():
            files = proposal_files()
            f = files[-1] if files else None
    if not f or not f.is_file():
        raise SystemExit("kit-ppmx: no proposals yet (kit-ppmx actions [MINUTES])")
    return f, json.loads(f.read_text(encoding="utf-8"))


def project_map():
    try:
        value = json.loads(PROJECT_MAP.read_text(encoding="utf-8-sig"))
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def show_proposals(f, data):
    print(f"Proposals from {data.get('from', '?')} ({data.get('made', '')[:16].replace('T', ' ')}), in {f.name}:")
    for p in data["proposals"]:
        mark = {"applied": "done: ", "failed": "FAILED: ", "unconfirmed": "NOT CONFIRMED (check PPM Express): "}.get(
            p.get("status"), "")
        print(f"  {p['n']}. {mark}{p['says']}" + (f" [{p.get('error')}]" if p.get("status") in ("failed", "unconfirmed")
                                                  else ""))
    todo = [p["n"] for p in data["proposals"] if p.get("status") == "proposed" and p["kind"] in ("create", "update")]
    if todo:
        print(f"To make one, say which (one at a time; Claude Code asks before each): kit-ppmx actions apply {todo[0]}")


def cmd_actions(env, argv):
    if argv[:1] == ["show"]:
        ap = argparse.ArgumentParser(prog="kit-ppmx actions show")
        ap.add_argument("--file")
        a = ap.parse_args(argv[1:])
        f, data = load_proposals(a.file)
        show_proposals(f, data)
        return 0
    if argv[:1] == ["apply"]:
        ap = argparse.ArgumentParser(prog="kit-ppmx actions apply")
        ap.add_argument("n", type=int, help="the proposal's number (one at a time)")
        ap.add_argument("--file")
        ap.add_argument("--again", action="store_true",
                        help="send a change PPM Express didn't confirm once more, after you've checked it isn't there")
        a = ap.parse_args(argv[1:])
        return apply_proposal(env, a.n, a.file, a.again)
    if argv[:1] == ["map"]:
        if len(argv) != 3:
            print('kit-ppmx: kit-ppmx actions map SLUG "PROJECT NAME or ID"', file=sys.stderr)
            return 2
        return map_project(env, argv[1], argv[2])
    ap = argparse.ArgumentParser(prog="kit-ppmx actions", description="Propose PPM Express tasks for meeting actions.")
    ap.add_argument("file", nargs="?", help="minutes with an Actions block (default: briefs/pending-actions.md)")
    ap.add_argument("--project", help="put every action in this PPM Express project (its name or ID)")
    a = ap.parse_args(argv)
    src = pathlib.Path(os.path.expanduser(a.file)) if a.file else KIT / "briefs" / "pending-actions.md"
    try:
        text = src.read_text(encoding="utf-8-sig")
    except OSError:
        print(f"kit-ppmx: can't read {src}", file=sys.stderr)
        return 2
    acts = actions_mod.parse(text)
    if not acts:
        print(f"kit-ppmx: no actions in {src.name} (lines that start \"- [action]\")")
        return 0
    got = ready(env)
    if not got:
        return 2
    settings, token = got
    ctx = Context(Client(settings), settings, tables_for(settings), token)
    names = my_names(ctx)
    me = next((n for n in names if "@" in n), names[0] if names else None)
    try:
        props = actions_mod.propose(ctx, acts, project_map(), me, a.project,
                                    due_key=env.get("PPMX_TASK_DUE_FIELD") or "FinishDate")
    except PPMXError as e:
        print(f"kit-ppmx: {e}", file=sys.stderr)
        return 1
    audit_logger(settings)({"ts": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                            "via": "kit-ppmx actions", "user": f"u:{token_key(token)[:12]}", "tool": "propose",
                            "outcome": "ok", "actions": len(acts), "proposals": len(props)})
    stem = re.sub(r"[^a-z0-9]+", "-", src.stem.lower()).strip("-") or "actions"
    out = WORK_DIR / f"actions-{stem}.json"
    try:
        before = json.loads(out.read_text(encoding="utf-8")).get("proposals", []) if out.is_file() else []
    except (OSError, ValueError):
        before = []
    made = {p["action"]: p for p in before if p.get("status") in ("applied", "unconfirmed")}
    for p in props:                                    # what was made (or may have been) stays made
        o = made.get(p["action"])
        if not o or (p.get("project") or {}).get("id") != (o.get("project") or {}).get("id"):
            continue                                   # another project (--project): a different change
        if p["kind"] == "create" or (p["kind"] == o.get("kind") and p.get("args") == o.get("args")):
            for k in ("status", "result_id", "applied", "error", "kind", "tool", "args", "says"):
                if k in o:
                    p[k] = o[k]
    data = {"from": str(src), "made": datetime.datetime.now().isoformat(timespec="seconds"), "proposals": props}
    private_write(out, json.dumps(data, indent=1, ensure_ascii=False))
    private_write(CURRENT, out.name + "\n")
    dropped = sum(1 for x in acts if x["status"] == "dropped")
    print(f"kit-ppmx: {len(acts)} action(s) in {src.name}" + (f", {dropped} dropped and left out" if dropped else "")
          + ". Nothing has changed in PPM Express.")
    show_proposals(out, data)
    for p in props:
        if p["kind"] == "no-project" and p.get("slug"):
            print(f'  (for "{p["slug"]}": kit-ppmx actions map {p["slug"]} "PROJECT NAME", then run this again)')
            break
    return 0


def apply_proposal(env, n, name=None, again=False):
    """Make one proposal in PPM Express, through the same tool the MCP server runs (and its audit line). Only a
    task's create or update, as proposed; never one that was made, or that may have been, unless --again."""
    f, data = load_proposals(name)
    p = next((x for x in data["proposals"] if x.get("n") == n), None)
    if not p:
        print(f"kit-ppmx: there's no proposal {n} in {f.name}", file=sys.stderr)
        return 2
    if p.get("kind") not in ("create", "update"):
        print(f"kit-ppmx: proposal {n} has nothing to make: {p.get('says')}", file=sys.stderr)
        return 2
    tool, args = p.get("tool"), p.get("args")
    if tool not in TASK_TOOLS or not isinstance(args, dict) or not set(args) <= TASK_TOOLS[tool] \
            or tool != {"create": "create_task", "update": "update_task"}[p["kind"]]:
        print(f"kit-ppmx: proposal {n} in {f.name} isn't a task change as kit-ppmx proposes them (was the file "
              "edited?); propose again with kit-ppmx actions", file=sys.stderr)
        return 2
    if p.get("status") == "applied":
        print(f"kit-ppmx: proposal {n} was made already ({p.get('result_id') or 'see PPM Express'})", file=sys.stderr)
        return 2
    if p.get("status") == "unconfirmed" and not again:
        print(f"kit-ppmx: PPM Express may already have proposal {n} (it didn't confirm last time). Check there; if "
              f"it isn't, kit-ppmx actions apply {n} --again", file=sys.stderr)
        return 2
    got = ready(env)
    if not got:
        return 2
    settings, token = got
    print(f"kit-ppmx: making {n} from {f.name}: {p['says']}")
    good, text = call(settings, token, tool, args, tables_for(settings), via="kit-ppmx actions apply")
    if good:
        res = json.loads(text)
        p.update(status="applied", result_id=res.get("id"), applied=datetime.datetime.now().isoformat(timespec="seconds"))
        p.pop("error", None)
        print(f"kit-ppmx: done" + (f" (ID {res.get('id')})" if res.get("id") else ""))
    elif any(u in text for u in UNCONFIRMED):
        p.update(status="unconfirmed", error=text[:300])
        print(f"kit-ppmx: {text}", file=sys.stderr)
    else:
        p.update(status="failed", error=text[:300])
        print(f"kit-ppmx: PPM Express didn't make it: {text}", file=sys.stderr)
    private_write(f, json.dumps(data, indent=1, ensure_ascii=False))
    return 0 if good else 1


def map_project(env, slug, project):
    got = ready(env)
    if not got:
        return 2
    settings, token = got
    ctx = Context(Client(settings), settings, tables_for(settings), token)
    try:
        rows = [r for r in ctx.rows("projects") if r.get("id")]
    except PPMXError as e:
        print(f"kit-ppmx: {e}", file=sys.stderr)
        return 1
    found, why = actions_mod.find_project(rows, slug, {}, project)
    if not found:
        print(f"kit-ppmx: {why}", file=sys.stderr)
        return 1
    m = project_map()
    m[slug] = str(found["id"])
    private_write(PROJECT_MAP, json.dumps(m, indent=1, ensure_ascii=False) + "\n")
    print(f'kit-ppmx: "{slug}" is now the PPM Express project {found.get("Name") or found.get("Title") or found["id"]}')
    return 0


def main(argv):
    for stream in (sys.stdout, sys.stderr):           # names and labels can be any language, on any console
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    if argv[:1] == ["pulse"]:
        return cmd_pulse(kit_env(), argv[1:])
    if argv[:1] == ["actions"]:
        return cmd_actions(kit_env(), argv[1:])
    ap = argparse.ArgumentParser(prog="kit-ppmx", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["serve", "check", "tools", "call", "desktop", "setup", "pulse", "actions"])
    ap.add_argument("tool", nargs="?")
    ap.add_argument("arguments", nargs="?", help="the tool's arguments as JSON")
    ap.add_argument("--remove", action="store_true", help="desktop: take the server out of Claude Desktop")
    ap.add_argument("--print", dest="show", action="store_true", help="desktop: show the entry; change nothing")
    a = ap.parse_args(argv)
    env = kit_env()
    if a.command == "serve":
        return cmd_serve(env)
    if a.command == "check":
        return cmd_check(env)
    if a.command == "tools":
        return cmd_tools()
    if a.command == "setup":
        return cmd_setup(env)
    if a.command == "desktop":
        return cmd_desktop(env, a.remove, a.show)
    if not a.tool:
        ap.error("give the tool's name: kit-ppmx call list_projects '{\"limit\": 5}'")
    return cmd_call(env, a.tool, a.arguments)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
