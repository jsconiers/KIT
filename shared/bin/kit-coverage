#!/usr/bin/env python3
"""kit-coverage: framework coverage per design and across the portfolio, from the library's artifacts.

  kit-coverage                       print the report as Markdown (nothing written)
  kit-coverage --json                the same as JSON
  kit-coverage --project P           one design only (a project folder name under artifacts/)
  kit-coverage --write               also save briefs/coverage.html, briefs/coverage.json, and
                                     briefs/coverage.md in Kit's folder (regenerated each run)
  kit-coverage --root DIR            a library root other than the one in library.md
  kit-coverage --out DIR             write the three files to DIR instead of Kit's briefs/

Reads what Kit's staff already save in <library root>/artifacts/<project>/, the latest version of each:
  NIST CSF 2.0       *csf-mapping*.md, read with kit-csf: coverage and open (no or partial) categories
  Zero Trust         *zero-trust-rating*.md: stage per pillar (Traditional, Initial, Advanced, Optimal,
                     or can't rate), the lowest pillar, and pillars below the target stage
  Standards          standards/*standards-check*.md: conforms, gap, can't tell, and not applicable
                     counts, and the rows under an Exceptions or Waivers heading (waiver candidates)
  Threat model       threat-model/*.md: high and medium threats that still have a gap
  Red team           red-team/*.md: critical and major findings not marked closed
  Secure by Design   reviews/*.md: the reviewer's Secure by Design table, yes, partial, and no counts
  Waivers            a register, if one exists: the file named in standards.md's Waivers field, a
                     waiver or exception register under <library root>/ (waivers/, exceptions/,
                     registers/), or *waiver*.md / *exception*.md in a project folder; open waivers are
                     rows whose status isn't closed, expired, revoked, rejected, or retired

The framework profile in compliance.md decides what is required: CSF, Zero Trust, and Secure by Design
are "required" only when marked yes there; the others are shown greyed as "not in profile". When the
profile isn't set, the report says so at the top and shows everything without marking any of it
required. Standards checks, threat models, red-team notes, and waivers are Kit's own reviews, so they
are always shown. A design that has no artifact for a required framework is listed under "no
assessment". Percentages and counts are reading aids, not compliance scores.

Read-only on the library; it never calls an outside service. Exit status: 0 done, 2 no library or
nothing to read.
"""
import argparse
import datetime as dt
import html
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import sys

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
import kit_arch as ka  # noqa: E402


def _load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


csf = _load("kit_csf", HERE / "kit-csf")   # CSF parsing and coverage math stay in one place

FRAMEWORKS = [  # key, label, profile row pattern (None: Kit's own review, always shown)
    # Anchored, so a profile row that only mentions CSF (the CRI Profile row) isn't read as CSF.
    ("csf", "NIST CSF 2.0", r"^\W*(nist\s+)?(csf\b|cybersecurity framework)"),
    ("zt", "Zero Trust", r"zero trust"),
    ("sbd", "Secure by Design", r"secure by design"),
    ("standards", "Standards check", None),
    ("threat", "Threat model", None),
    ("redteam", "Red team", None),
    ("waivers", "Waivers", None),
]
LABEL = {k: l for k, l, _ in FRAMEWORKS}
ZT_STAGES = {"traditional": 0, "initial": 1, "advanced": 2, "optimal": 3}
ZT_NAMES = ["Traditional", "Initial", "Advanced", "Optimal"]
CLOSED = re.compile(r"\b(closed|expired|revoked|rejected|retired|withdrawn|resolved|done|mitigated|fixed)\b", re.I)
SKIP_DIRS = {"viewpoints", "onepager"}


# ---------------------------------------------------------------- reading

def rows_of(lines):
    """Markdown tables as (heading above, header cells lower, [row cells]), one per table."""
    out, head, cur, heading = [], None, None, ""
    for line in lines + [""]:
        s = line.strip()
        m = re.match(r"^#{1,6}\s+(.*)", s)
        if m:
            heading = m.group(1).strip()
        if s.startswith("|"):
            cells = csf.cells(s)
            if re.fullmatch(r"\|?[\s:|-]+\|?", s):
                continue
            if cur is None:
                cur = {"heading": heading, "head": [c.lower().strip("*_ ") for c in cells], "rows": []}
                out.append(cur)
            else:
                cells += [""] * (len(cur["head"]) - len(cells))
                cur["rows"].append(cells)
        else:
            cur = None
    return out


def read(path):
    try:
        return path.read_text(errors="replace").splitlines()
    except OSError:
        return []


def colx(head, *pats):
    for p in pats:
        for i, h in enumerate(head):
            if re.search(p, h):
                return i
    return None


def val(row, i):
    return row[i].strip("*` ") if i is not None and i < len(row) else ""


def usable(v):
    v = (v or "").strip()
    return bool(v) and not re.fullmatch(r"<[^>]*>", v) and v.lower() not in ("-", "—")


def version_key(p):
    m = re.search(r"-v(\d+)(?:\.(\d+))?(?=[.-]|$)", p.stem)
    return (int(m.group(1)), int(m.group(2) or 0), p.stat().st_mtime) if m else (0, 0, p.stat().st_mtime)


def latest(files):
    files = [f for f in files if f.is_file() and not f.name.endswith("-template.md")]
    return max(files, key=version_key) if files else None


def proj_files(proj, pattern, sub=None):
    base = proj / sub if sub else proj
    if not base.is_dir():
        return []
    return [p for p in base.rglob(pattern) if not (set(p.relative_to(proj).parts[:-1]) & SKIP_DIRS)]


def rel(p, root):
    try:
        return str(p.relative_to(root))
    except ValueError:
        return str(p)


# ---------------------------------------------------------------- one artifact type each

def read_csf(proj, funcs, cats):
    cands = proj_files(proj, "*csf*.md")
    good = []
    for p in cands:
        r = csf.analyse(p, funcs, cats)
        if r["rows"]:
            good.append((p, r))
    if not good:
        return None
    p, r = max(good, key=lambda x: version_key(x[0]))
    return {"file": p, "coverage_pct": r["overall"]["coverage_pct"],
            "open": len(r["gaps"]), "no": sum(1 for g in r["gaps"] if g["status"] == "no"),
            "blank": len(r["blank"]) + len(r["missing"]), "categories": r["categories"],
            "functions": {f: s["coverage_pct"] for f, s in r["functions"].items()},
            "gaps": [f"{g['id']} {g['category']} ({g['status']})" for g in r["gaps"]]}


def read_zt(proj):
    p = latest(proj_files(proj, "*zero-trust*.md"))
    if not p:
        return None
    lines = read(p)
    target = None
    pillars = {}
    for t in rows_of(lines):
        h = t["head"]
        if h[:2] == ["field", "value"]:
            for r in t["rows"]:
                if r[0].lower().startswith("target stage") and usable(r[1]):
                    target = ZT_STAGES.get(r[1].strip().lower().split()[0])
            continue
        a, s = colx(h, r"^area|^pillar|capabilit"), colx(h, r"^stage|^level|^rating|maturity")
        if a is None or s is None:
            continue
        for r in t["rows"]:
            area, stage = val(r, a), val(r, s).lower()
            if not usable(area):
                continue
            area = re.sub(r"\s*\(cross-cutting\)", "", area)
            lvl = next((v for k, v in ZT_STAGES.items() if stage.startswith(k)), None)
            if not usable(stage):
                pillars[area] = "blank"
            else:
                pillars[area] = lvl if lvl is not None else "can't rate"
    if not pillars:
        return None
    rated = {a: v for a, v in pillars.items() if isinstance(v, int)}
    low = min(rated.values()) if rated else None
    below = [a for a, v in rated.items() if target is not None and v < target]
    return {"file": p, "pillars": pillars, "target": ZT_NAMES[target] if target is not None else None,
            "lowest": ZT_NAMES[low] if low is not None else None,
            "lowest_pillars": [a for a, v in rated.items() if v == low],
            "cant_rate": [a for a, v in pillars.items() if v in ("can't rate", "blank")],
            "below_target": below, "open": len(below) + sum(1 for v in pillars.values() if not isinstance(v, int))}


def result_kind(v):
    v = v.lower().strip()
    if re.match(r"(conforms?|pass|meets|compliant|yes)\b", v):
        return "conforms"
    if re.match(r"(gap|fail|does not|non-?conform|no)\b", v):
        return "gap"
    if re.match(r"(not applicable|n/?a)\b", v):
        return "na"
    if re.match(r"(can'?t tell|cannot tell|unknown|unclear|not stated)", v):
        return "cant_tell"
    return None


def read_standards(proj):
    p = latest(proj_files(proj, "*standards-check*.md", "standards") or proj_files(proj, "*conformance*.md"))
    if not p:
        return None
    counts = {"conforms": 0, "gap": 0, "cant_tell": 0, "na": 0}
    waivers = []
    for t in rows_of(read(p)):
        h = t["head"]
        if re.search(r"exception|waiver", t["heading"], re.I) and t["rows"]:
            for r in t["rows"]:
                if any(usable(c) for c in r):
                    waivers.append("; ".join(c for c in r[:3] if usable(c)))
            continue
        rc = colx(h, r"^result$", r"^result|^status|^conform")
        if rc is None:
            continue
        for r in t["rows"]:
            k = result_kind(val(r, rc))
            if k:
                counts[k] += 1
    return {"file": p, **counts, "waiver_candidates": len(waivers), "waivers": waivers,
            "open": counts["gap"] + counts["cant_tell"]}


def read_threat(proj):
    p = latest(proj_files(proj, "*.md", "threat-model"))
    if not p:
        return None
    high = med = low = 0
    items = []
    for t in rows_of(read(p)):
        h = t["head"]
        rk = colx(h, r"^risk$", r"^risk\b(?!.*rule)", r"^rating")
        gp = colx(h, r"^gap")
        if rk is None or gp is None or colx(h, r"stride|threat") is None:
            continue
        st = colx(h, r"^status")
        for r in t["rows"]:
            risk, gap = val(r, rk).lower(), val(r, gp)
            if not usable(gap) or re.match(r"(none|no gap|n/?a)\b", gap.lower()):
                continue
            if st is not None and CLOSED.search(val(r, st)):
                continue
            if risk.startswith("high"):
                high += 1
                items.append(f"{val(r, 0)} high: {gap}")
            elif risk.startswith("med"):
                med += 1
                items.append(f"{val(r, 0)} medium: {gap}")
            elif risk.startswith("low"):
                low += 1
    return {"file": p, "high": high, "medium": med, "low": low, "open": high + med, "items": items[:10]}


def read_redteam(proj):
    p = latest(proj_files(proj, "*.md", "red-team"))
    if not p:
        return None
    crit = major = minor = 0
    items = []
    for t in rows_of(read(p)):
        h = t["head"]
        c = colx(h, r"^consequence", r"^severity")
        if c is None:
            continue
        st = colx(h, r"^status")
        for r in t["rows"]:
            v = val(r, c).lower()
            if st is not None and CLOSED.search(val(r, st)):
                continue
            if v.startswith("critical"):
                crit += 1
                items.append(f"{val(r, 0)} critical")
            elif v.startswith("major"):
                major += 1
                items.append(f"{val(r, 0)} major")
            elif v.startswith("minor"):
                minor += 1
    return {"file": p, "critical": crit, "major": major, "minor": minor, "open": crit + major, "items": items[:10]}


def read_sbd(proj):
    best = None
    for p in sorted(proj_files(proj, "*.md", "reviews"), key=version_key, reverse=True):
        for t in rows_of(read(p)):
            h = t["head"]
            a = colx(h, r"^answer")
            if a is None or not (re.search(r"secure by design", t["heading"], re.I) or colx(h, r"question")):
                continue
            q = colx(h, r"question")
            n = colx(h, r"^#$|^no\.?$|^id$")
            counts = {"yes": 0, "partial": 0, "no": 0}
            weak = []
            for r in t["rows"]:
                v = val(r, a).lower()
                k = "yes" if v.startswith("yes") else "partial" if v.startswith(("partial", "not stated")) else \
                    "no" if v.startswith("no") else None
                if k:
                    counts[k] += 1
                    if k != "yes":
                        weak.append({"n": val(r, n) if n is not None else "", "question": val(r, q) if q is not None
                                     else "", "answer": k})
            if sum(counts.values()):
                best = {"file": p, **counts, "weak": weak, "open": counts["no"] + counts["partial"]}
                break
        if best:
            break
    return best


def waiver_registers(root):
    found = []
    std = ka.CONTEXT / "standards.md"
    if std.exists():
        body = ka.field(std.read_text(errors="replace"), "Waivers")
        for m in re.findall(r"`([^`]+\.md)`", body):
            p = ka.expand(m)
            p = p if p.is_absolute() else root / p
            if p.is_file():
                found.append(p)
    for sub in ("waivers", "exceptions", "registers", "."):
        d = root / sub
        if d.is_dir():
            for p in d.glob("*.md"):
                if re.search(r"waiver|exception", p.name, re.I) and p not in found:
                    found.append(p)
    return found


def read_waivers(files, projects, root):
    """Open waivers: {project or '': [ {text, status, expiry, file} ]}."""
    out = {}
    names = {p.name.lower(): p.name for p in projects}
    for f in files:
        in_proj = None
        try:
            parts = f.relative_to(root / "artifacts").parts
            in_proj = parts[0] if len(parts) > 1 else None
        except ValueError:
            pass
        for t in rows_of(read(f)):
            h = t["head"]
            if h[:2] == ["field", "value"]:
                continue
            st = colx(h, r"^status|^state")
            if st is None:
                continue
            pc = colx(h, r"^project|^design|^system")
            ex = colx(h, r"expir|until|review date|end date")
            what = colx([""] + h[1:], r"^standard|^control|^exception|^waiver|^requirement|^clause|^what")
            for r in t["rows"]:
                if not any(usable(c) for c in r):
                    continue
                status = val(r, st)
                if not usable(status) or CLOSED.search(status):
                    continue
                proj = in_proj
                if pc is not None and usable(val(r, pc)):
                    proj = names.get(val(r, pc).lower(), val(r, pc))
                text = "; ".join(c for c in ([val(r, 0)] + ([val(r, what)] if what not in (None, 0) else []))
                                 if usable(c))
                out.setdefault(proj or "", []).append(
                    {"text": text, "status": status, "expiry": val(r, ex) if ex is not None and usable(val(r, ex))
                     else "", "file": rel(f, root)})
    return out


# ---------------------------------------------------------------- the profile

def read_profile():
    f = ka.CONTEXT / "compliance.md"
    prof = {"set": False, "file": str(f), "frameworks": {}, "other_yes": []}
    if not f.exists():
        prof["why"] = "compliance.md not found"
        return prof
    lines = read(f)
    for t in rows_of(lines):
        h = t["head"]
        fc, ac = colx(h, r"^framework"), colx(h, r"^applies")
        if fc is None or ac is None:
            continue
        for r in t["rows"]:
            name, ap = val(r, fc), val(r, ac).lower()
            state = "yes" if ap.startswith("yes") else "not set" if (not ap or ap.startswith("not")) else \
                "no" if ap.startswith("no") else "not set"
            hit = None
            for key, _, pat in FRAMEWORKS:
                if pat and re.search(pat, name, re.I):
                    hit = key
            if hit:
                prof["frameworks"][hit] = {"row": name, "applies": state}
            elif state == "yes":
                prof["other_yes"].append(name)
            if state != "not set":
                prof["set"] = True
    if not prof["set"]:
        prof["why"] = "no framework in compliance.md's framework profile is marked yes or no"
    return prof


def framework_state(prof, key):
    pat = next(p for k, _, p in FRAMEWORKS if k == key)
    if pat is None:
        return "kit review"
    if not prof["set"]:
        return "profile not set"
    return "required" if prof["frameworks"].get(key, {}).get("applies") == "yes" else "not in profile"


# ---------------------------------------------------------------- building

def summary_text(key, d):
    if d is None:
        return "no assessment"
    if key == "csf":
        pct = "n/a" if d["coverage_pct"] is None else f"{d['coverage_pct']:.1f}%"
        return f"{pct}; {d['open']} open ({d['no']} no)" + (f"; {d['blank']} blank" if d["blank"] else "")
    if key == "zt":
        s = f"lowest {d['lowest'] or 'n/a'}"
        if d["lowest_pillars"]:
            s += f" ({', '.join(d['lowest_pillars'][:2])})"
        if d["target"]:
            s += f"; {len(d['below_target'])} below {d['target']}"
        if d["cant_rate"]:
            s += f"; {len(d['cant_rate'])} can't rate"
        return s
    if key == "standards":
        return (f"{d['conforms']} conform, {d['gap']} gap, {d['cant_tell']} can't tell; "
                f"{d['waiver_candidates']} waiver candidate(s)")
    if key == "threat":
        return f"{d['high']} high, {d['medium']} medium open"
    if key == "redteam":
        return f"{d['critical']} critical, {d['major']} major open"
    if key == "sbd":
        return f"{d['yes']} yes, {d['partial']} partial, {d['no']} no"
    if key == "waivers":
        return f"{len(d)} open"
    return ""


def build(root, only=None):
    art = root / "artifacts"
    projects = sorted([p for p in art.iterdir() if p.is_dir() and not p.name.startswith(".")],
                      key=lambda p: p.name.lower()) if art.is_dir() else []
    if only:
        projects = [p for p in projects if p.name == only]
    prof = read_profile()
    _, funcs, cats = csf.load_data()
    regs = waiver_registers(root)
    proj_waiver_files = [f for p in projects for f in proj_files(p, "*.md")
                         if re.search(r"waiver|exception", f.name, re.I) and "standards-check" not in f.name]
    waivers = read_waivers(regs + proj_waiver_files, projects, root)
    designs = []
    for p in projects:
        data = {"csf": read_csf(p, funcs, cats), "zt": read_zt(p), "sbd": read_sbd(p),
                "standards": read_standards(p), "threat": read_threat(p), "redteam": read_redteam(p),
                "waivers": waivers.get(p.name)}
        row = {"design": p.name, "folder": rel(p, root), "frameworks": {}}
        for key, label, _ in FRAMEWORKS:
            d = data[key]
            state = framework_state(prof, key)
            entry = {"label": label, "state": state, "assessed": d is not None, "summary": summary_text(key, d)}
            if key == "waivers":
                entry["assessed"] = bool(d)
                entry["summary"] = f"{len(d)} open" if d else "none open"
                entry["open"] = len(d or [])
                entry["items"] = d or []
            elif d is not None:
                entry["open"] = d["open"]
                entry["file"] = rel(d["file"], root)
                entry["detail"] = {k: v for k, v in d.items() if k not in ("file",)}
            row["frameworks"][key] = entry
        row["any_assessment"] = any(e["assessed"] for k, e in row["frameworks"].items() if k != "waivers")
        designs.append(row)
    return {"generated": dt.date.today().strftime("%d-%b-%Y"), "root": str(root), "profile": prof,
            "designs": designs, "portfolio": portfolio(designs, prof, cats, waivers),
            "registers": [rel(f, root) for f in regs]}


def portfolio(designs, prof, cats, waivers):
    req = [k for k, _, p in FRAMEWORKS if p and framework_state(prof, k) == "required"]
    profiled = [k for k, _, p in FRAMEWORKS if p]
    weakest = []
    counts = {}
    for d in designs:
        c = d["frameworks"]["csf"].get("detail")
        if c:
            for cid, st in c["categories"].items():
                if st in ("no", "partial"):
                    counts.setdefault(cid, {"no": 0, "partial": 0})[st] += 1
    for cid, n in sorted(counts.items(), key=lambda kv: (-(kv[1]["no"] + 0.5 * kv[1]["partial"]), kv[0])):
        weakest.append({"framework": "NIST CSF 2.0", "category": f"{cid} {cats[cid]['name']}",
                        "designs_no": n["no"], "designs_partial": n["partial"]})
    zt = {}
    for d in designs:
        z = d["frameworks"]["zt"].get("detail")
        if z:
            for a, v in z["pillars"].items():
                zt.setdefault(a, []).append(v)
    for a, vs in zt.items():
        rated = [v for v in vs if isinstance(v, int)]
        unrated = len(vs) - len(rated)
        low = min(rated) if rated else None
        if (low is not None and low <= 1) or unrated:
            weakest.append({"framework": "Zero Trust", "category": a,
                            "lowest": ZT_NAMES[low] if low is not None else "n/a",
                            "designs_low": sum(1 for v in rated if v <= 1), "cant_rate": unrated})
    sbd = {}
    for d in designs:
        s = d["frameworks"]["sbd"].get("detail")
        if s:
            for w in s["weak"]:
                key = (w["n"], w["question"])
                sbd.setdefault(key, {"no": 0, "partial": 0})[w["answer"]] += 1
    for (n, q), c in sorted(sbd.items(), key=lambda kv: (-(kv[1]["no"] + 0.5 * kv[1]["partial"]), kv[0])):
        weakest.append({"framework": "Secure by Design", "category": f"{n} {q}".strip(),
                        "designs_no": c["no"], "designs_partial": c["partial"]})
    no_assessment = {}
    for k in (req or profiled):
        missing = [d["design"] for d in designs if not d["frameworks"][k]["assessed"]]
        if missing:
            no_assessment[LABEL[k]] = missing
    open_waivers = [dict(w, design=proj or "(no project named)") for proj, ws in sorted(waivers.items())
                    for w in ws]
    return {"designs": len(designs), "required": [LABEL[k] for k in req],
            "weakest": weakest[:15], "no_assessment": no_assessment,
            "nothing_assessed": [d["design"] for d in designs if not d["any_assessment"]],
            "open_waivers": open_waivers,
            "open_totals": {LABEL[k]: sum(d["frameworks"][k].get("open", 0) for d in designs)
                            for k, _, _ in FRAMEWORKS}}


# ---------------------------------------------------------------- Markdown

def profile_line(prof):
    if not prof["set"]:
        return (f"**Framework profile not set** ({prof.get('why', '')}; {prof['file']}): every framework is "
                "shown, none is marked required.")
    req = [LABEL[k] for k, v in prof["frameworks"].items() if v["applies"] == "yes"]
    line = "Framework profile (compliance.md): required: " + (", ".join(req) or "none of CSF, Zero Trust, "
                                                               "Secure by Design")
    if prof["other_yes"]:
        line += "; also in profile, with no Kit artifact to measure: " + ", ".join(prof["other_yes"])
    return line + "."


def cell_md(e):
    s = e["summary"]
    if e["state"] == "not in profile":
        return f"({s}; not in profile)"
    if e["state"] == "required" and not e["assessed"]:
        return f"**{s}** (required)"
    return s


def render_md(res):
    out = [f"# Framework coverage: {res['portfolio']['designs']} design(s)", "",
           f"Library: {res['root']}. Updated {res['generated']}.", "", profile_line(res["profile"]), ""]
    keys = [k for k, _, _ in FRAMEWORKS]
    out += ["## Per design", "", "| Design | " + " | ".join(LABEL[k] for k in keys) + " |",
            "|" + "---|" * (len(keys) + 1)]
    for d in res["designs"]:
        out.append(f"| {d['design']} | " + " | ".join(cell_md(d["frameworks"][k]).replace("|", "/")
                                                      for k in keys) + " |")
    if not res["designs"]:
        out.append("| none found | " + " | ".join("" for _ in keys) + " |")
    out += ["", "## Open gaps by design", ""]
    any_gap = False
    for d in res["designs"]:
        lines = []
        f = d["frameworks"]
        if f["csf"].get("detail"):
            lines += [f"CSF {g}" for g in f["csf"]["detail"]["gaps"][:5]]
        if f["zt"].get("detail"):
            z = f["zt"]["detail"]
            lines += [f"Zero Trust {a} below target {z['target']}" for a in z["below_target"]]
            lines += [f"Zero Trust {a}: can't rate" for a in z["cant_rate"]]
        if f["standards"].get("detail"):
            s = f["standards"]["detail"]
            lines += [f"Waiver candidate: {w}" for w in s["waivers"][:5]]
        if f["threat"].get("detail"):
            lines += [f"Threat {i}" for i in f["threat"]["detail"]["items"][:5]]
        if f["redteam"].get("detail"):
            lines += [f"Red team {i}" for i in f["redteam"]["detail"]["items"][:5]]
        if f["sbd"].get("detail"):
            lines += [f"Secure by Design {w['n']} {w['question']}: {w['answer']}".replace("  ", " ")
                      for w in f["sbd"]["detail"]["weak"][:5]]
        lines += [f"Waiver open: {w['text']} ({w['status']}{', expires ' + w['expiry'] if w['expiry'] else ''})"
                  for w in f["waivers"]["items"]]
        if lines:
            any_gap = True
            out.append(f"- **{d['design']}**: " + "; ".join(lines))
    if not any_gap:
        out.append("- none")
    p = res["portfolio"]
    out += ["", "## Portfolio", "", "Weakest categories:"]
    for w in p["weakest"]:
        if w["framework"] == "Zero Trust":
            out.append(f"- Zero Trust {w['category']}: lowest {w['lowest']}, Traditional or Initial in "
                       f"{w['designs_low']}, can't rate in {w['cant_rate']}")
        else:
            out.append(f"- {w['framework']} {w['category']}: no in {w['designs_no']}, partial in "
                       f"{w['designs_partial']}")
    if not p["weakest"]:
        out.append("- none")
    out.append("Designs with no assessment" + (" (required frameworks):" if p["required"] else ":"))
    for fw, ds in p["no_assessment"].items():
        out.append(f"- {fw}: {', '.join(ds)}")
    if p["nothing_assessed"]:
        out.append(f"- Nothing assessed at all: {', '.join(p['nothing_assessed'])}")
    if not p["no_assessment"] and not p["nothing_assessed"]:
        out.append("- none")
    out.append("Open waivers:")
    for w in p["open_waivers"]:
        out.append(f"- {w['design']}: {w['text']} ({w['status']}"
                   f"{', expires ' + w['expiry'] if w['expiry'] else ''}) [{w['file']}]")
    if not p["open_waivers"]:
        out.append("- none" + ("" if res["registers"] else " (no waiver register found)"))
    out += ["", "Each cell reads the latest version of that artifact in the design's folder. Counts and "
            "percentages are reading aids, not compliance scores; check the artifact before relying on one."]
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------- HTML

CSS = """
:root { --board:#E3E7EA; --strip:#FFFFFF; --ink:#15202B; --muted:#566573; --line:#C9D0D6;
  --you:#1F4E79; --kit:#C1121F; --wait:#B7791F; --ok:#2E7D4F;
  --cond:"Arial Narrow","Helvetica Neue",Arial,sans-serif; --body:system-ui,"Segoe UI",Arial,sans-serif; }
@media (prefers-color-scheme: dark) { :root { --board:#11171D; --strip:#1A222A; --ink:#E4EAEE; --muted:#9AA8B4;
  --line:#2A353F; --you:#6FA8DC; --kit:#F0464F; --wait:#E3A73C; --ok:#5CC28A; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--board); color:var(--ink); font:16px/1.5 var(--body); }
header { padding:1.25rem 2rem .5rem; } header h1 { font:700 2rem/1 var(--cond); margin:0; }
header p { color:var(--muted); margin:.3rem 0 0; }
.banner { background:var(--kit); color:#FFFFFF; padding:.75rem 2rem; font:600 1.1rem/1.3 var(--cond); }
.note { padding:.5rem 2rem; color:var(--muted); }
main { padding:1rem 2rem 3rem; display:grid; gap:1.5rem; }
.panel { background:var(--strip); padding:1rem 1.2rem 1.2rem; overflow-x:auto; }
.panel h2 { font:600 1.35rem/1.2 var(--cond); margin:0 0 .75rem; }
table { border-collapse:collapse; width:100%; font-size:.92rem; }
th, td { padding:.35rem .5rem; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
thead th { color:var(--muted); font:600 .95rem/1.2 var(--cond); }
td.required.missing { color:var(--kit); font-weight:600; }
td.open { border-left:4px solid var(--wait); } td.clear { border-left:4px solid var(--ok); }
td.greyed, th.greyed { color:var(--muted); opacity:.55; font-style:italic; }
td.missing { border-left:4px solid var(--line); }
ul { margin:.2rem 0 .6rem; padding-left:1.2rem; } li { margin:.15rem 0; }
.muted { color:var(--muted); } code { font-size:.9em; }
"""


def render_html(res):
    e = html.escape
    keys = [k for k, _, _ in FRAMEWORKS]
    prof = res["profile"]
    head_cells = []
    for k in keys:
        st = framework_state(prof, k)
        tag = {"required": " (required)", "not in profile": " (not in profile)"}.get(st, "")
        head_cells.append(f'<th scope="col" class="{"greyed" if st == "not in profile" else ""}">'
                          f'{e(LABEL[k])}{e(tag)}</th>')
    rows = []
    for d in res["designs"]:
        cells = []
        for k in keys:
            f = d["frameworks"][k]
            cls = []
            if f["state"] == "not in profile":
                cls.append("greyed")
            if not f["assessed"]:
                cls.append("missing")
                if f["state"] == "required":
                    cls.append("required")
            else:
                cls.append("open" if f.get("open") else "clear")
            title = f' title="{e(f["file"])}"' if f.get("file") else ""
            cells.append(f'<td class="{" ".join(cls)}"{title}>{e(f["summary"])}</td>')
        rows.append(f'<tr><th scope="row">{e(d["design"])}</th>{"".join(cells)}</tr>')
    if not rows:
        rows.append(f'<tr><td colspan="{len(keys) + 1}" class="muted">No project folders under artifacts/.</td></tr>')
    p = res["portfolio"]

    def ul(items):
        return "<ul>" + "".join(f"<li>{e(i)}</li>" for i in items) + "</ul>" if items else \
            '<p class="muted">None.</p>'

    weak = []
    for w in p["weakest"]:
        if w["framework"] == "Zero Trust":
            weak.append(f"Zero Trust {w['category']}: lowest {w['lowest']}, Traditional or Initial in "
                        f"{w['designs_low']}, can't rate in {w['cant_rate']}")
        else:
            weak.append(f"{w['framework']} {w['category']}: no in {w['designs_no']}, partial in "
                        f"{w['designs_partial']}")
    noass = [f"{fw}: {', '.join(ds)}" for fw, ds in p["no_assessment"].items()]
    if p["nothing_assessed"]:
        noass.append(f"Nothing assessed at all: {', '.join(p['nothing_assessed'])}")
    waiv = [f"{w['design']}: {w['text']} ({w['status']}{', expires ' + w['expiry'] if w['expiry'] else ''})"
            for w in p["open_waivers"]]
    banner = "" if prof["set"] else \
        (f'<div class="banner" role="status">Framework profile not set: {e(prof.get("why", ""))}. Every '
         f'framework is shown; none is marked required.</div>')
    note = "" if not prof["set"] else f'<p class="note">{e(profile_line(prof).replace("**", ""))}</p>'
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kit: framework coverage</title>
<style>{CSS}</style></head>
<body>
<header><h1>Framework coverage</h1>
<p>{p['designs']} design(s) in {e(res['root'])}. Updated <time>{e(res['generated'])}</time>.</p></header>
{banner}{note}
<main>
<section class="panel" aria-labelledby="h-designs"><h2 id="h-designs">Per design</h2>
<table><thead><tr><th scope="col">Design</th>{''.join(head_cells)}</tr></thead>
<tbody>{''.join(rows)}</tbody></table>
<p class="muted">Each cell reads the latest version of that artifact in the design's folder (hover for the file).
Amber edge: open gaps. Green edge: none open. Greyed: not in the framework profile. Counts and percentages are
reading aids, not compliance scores.</p></section>
<section class="panel" aria-labelledby="h-weak"><h2 id="h-weak">Weakest categories</h2>{ul(weak)}</section>
<section class="panel" aria-labelledby="h-none"><h2 id="h-none">Designs with no assessment</h2>{ul(noass)}</section>
<section class="panel" aria-labelledby="h-waive"><h2 id="h-waive">Open waivers</h2>{ul(waiv)}</section>
</main></body></html>
"""


# ---------------------------------------------------------------- main

def to_json(res):
    def clean(o):
        if isinstance(o, dict):
            return {k: clean(v) for k, v in o.items() if k != "categories"}
        if isinstance(o, list):
            return [clean(v) for v in o]
        if isinstance(o, pathlib.Path):
            return str(o)
        return o
    return clean(res)


def write_atomic(path, text):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def main(argv):
    ap = argparse.ArgumentParser(prog="kit-coverage", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--project")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--root")
    ap.add_argument("--out")
    a = ap.parse_args(argv)
    root = ka.expand(a.root) if a.root else ka.library_root()
    if not root:
        print("kit-coverage: no library root (set it in memory/context/library.md, or pass --root DIR)",
              file=sys.stderr)
        return 2
    if not (root / "artifacts").is_dir():
        print(f"kit-coverage: no artifacts/ folder under {root}", file=sys.stderr)
        return 2
    if a.project and not (root / "artifacts" / a.project).is_dir():
        print(f"kit-coverage: no project folder {a.project} under {root / 'artifacts'}", file=sys.stderr)
        return 2
    res = build(root, a.project)
    data = to_json(res)
    md = render_md(res)
    print(json.dumps(data, indent=2) if a.json else md, end="\n" if a.json else "")
    if a.write:
        out = ka.expand(a.out) if a.out else ka.KIT / "briefs"
        out.mkdir(parents=True, exist_ok=True)
        write_atomic(out / "coverage.html", render_html(res))
        write_atomic(out / "coverage.json", json.dumps(data, indent=2) + "\n")
        write_atomic(out / "coverage.md", md)
        print(f"kit-coverage: wrote {out / 'coverage.html'}, coverage.json, and coverage.md", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
