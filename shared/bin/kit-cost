#!/usr/bin/env python3
"""kit-cost: what Kit's scheduled runs cost, and a budget guard for them.

  kit-cost                          this month so far: spend, budget used, projection, costliest runs
  kit-cost report [--month YYYY-MM] [--by mode|day|model] [--json]
                                    a month by run kind, by day, and by model, against the month
                                    before; --by shows one table only
  kit-cost check [--mode MODE] [--json]
                                    exit 0 ok, 1 over the warning level, 2 over the stop level;
                                    with --mode, also says whether that kind of run may go ahead
  kit-cost record --mode MODE --rc N --json-file FILE [--log FILE]
                                    used by run.sh: read one run's JSON output, write its text
                                    result to the log, and add a line to the ledger
  kit-cost record-usage --source delegate|kit-run --provider P --model M [--input N] [--output N]
                        [--cost USD] [--mode MODE]
                                    add a line for model use outside Claude Code's own runs (the
                                    kit-delegate tool and the kit-run runtime); without --cost the
                                    line counts as "not priced"

Each scheduled run (run.sh) asks Claude Code for JSON output and records its estimated cost and
token counts in .install/logs/cost.jsonl, with the cost and tokens for each model the run used
(Claude Code's modelUsage), so reports can show spend by model. Only Kit's scheduled runs are in that ledger; your own
interactive sessions aren't. See those with /cost (this session) and /usage (plan limits) in
Claude Code. All figures are Claude Code's client-side estimates, not your bill.

Settings, in .install/shared/morning/config:
  COST_BUDGET_MONTHLY   monthly budget for scheduled runs, in US dollars; empty means no budget
  COST_WARN_PCT         at this share of the budget, runs go ahead and the brief says so (80)
  COST_STOP_PCT         at this share, only the essential runs go ahead (95)
  COST_ESSENTIAL_MODES  run kinds that always go ahead, separated by spaces ("morning")

To undo: delete the COST_ lines from the config, and the ledger if you like; run.sh then records
costs but never skips a run.
"""
import argparse
import calendar
import datetime as dt
import json
import os
import pathlib
import re
import sys

KIT = pathlib.Path(os.path.expanduser(os.environ.get("KIT_DIR", "~/Claude/Agents/kit")))
CONFIG = KIT / ".install/shared/morning/config"
LEDGER = KIT / ".install/logs/cost.jsonl"


def setting(key, default):
    if os.environ.get(key):
        return os.environ[key]
    if CONFIG.exists():
        m = re.search(rf'^{key}="([^"]*)"', CONFIG.read_text(errors="ignore"), re.M)
        if m and m.group(1).strip():
            return m.group(1).strip()
    return default


def number(key, default):
    raw = setting(key, "")
    try:
        return float(raw) if raw != "" else default
    except ValueError:
        return default


def today():
    """Today's date; KIT_COST_TODAY (YYYY-MM-DD) overrides it for tests."""
    fake = os.environ.get("KIT_COST_TODAY")
    return dt.date.fromisoformat(fake) if fake else dt.date.today()


def entries():
    if not LEDGER.exists():
        return []
    out = []
    for line in LEDGER.read_text(errors="ignore").splitlines():
        try:
            rec = json.loads(line)
            if isinstance(rec, dict) and rec.get("date"):
                out.append(rec)
        except ValueError:
            continue
    return out


def month_of(rec):
    return str(rec.get("date", ""))[:7]


def cost(rec):
    try:
        return float(rec.get("cost_usd") or 0)
    except (TypeError, ValueError):
        return 0.0


def num(x):
    try:
        return float(x)
    except (TypeError, ValueError):
        return None


def models_from(data):
    """Per-model cost and tokens from Claude Code's JSON result (modelUsage, keyed by model id).
    Returns {} when the field is missing or not in the expected shape."""
    mu = data.get("modelUsage")
    if not isinstance(mu, dict):
        return {}
    out = {}
    for name, u in mu.items():
        if not isinstance(u, dict):
            continue
        out[str(name)] = {"cost_usd": num(u.get("costUSD")),
                          "input_tokens": u.get("inputTokens"), "output_tokens": u.get("outputTokens"),
                          "cache_read_tokens": u.get("cacheReadInputTokens"),
                          "cache_write_tokens": u.get("cacheCreationInputTokens")}
    return out


def primary_model(models):
    """The model that cost the most (or, when none is priced, wrote the most output)."""
    if not models:
        return "unknown"
    return max(models, key=lambda m: ((models[m].get("cost_usd") or 0), (models[m].get("output_tokens") or 0)))


def model_spend(rec):
    """[(model, cost or None)] for one ledger line. Old lines without models count as "unknown"."""
    ms = rec.get("models")
    if isinstance(ms, dict) and ms:
        return [(m, num(v.get("cost_usd")) if isinstance(v, dict) else None) for m, v in ms.items()]
    return [(rec.get("model") or "unknown", num(rec.get("cost_usd")))]


def by_model(recs):
    """{model: {"runs": n, "spend_usd": x, "unpriced": n}} across ledger lines."""
    out = {}
    for r in recs:
        for m, c in model_spend(r):
            row = out.setdefault(m, {"runs": 0, "spend_usd": 0.0, "unpriced": 0})
            row["runs"] += 1
            if c is None:
                row["unpriced"] += 1
            else:
                row["spend_usd"] += c
    return {m: {**v, "spend_usd": round(v["spend_usd"], 4)}
            for m, v in sorted(out.items(), key=lambda kv: -kv[1]["spend_usd"])}


def status(month=None):
    """Spend, budget, and levels for a month (this month by default)."""
    day = today()
    month = month or day.strftime("%Y-%m")
    recs = [r for r in entries() if month_of(r) == month]
    spend = sum(cost(r) for r in recs)
    year, mon = (int(x) for x in month.split("-"))
    days = calendar.monthrange(year, mon)[1]
    elapsed = day.day if month == day.strftime("%Y-%m") else days
    projection = spend / elapsed * days if elapsed else spend
    budget = number("COST_BUDGET_MONTHLY", 0.0)
    warn, stop = number("COST_WARN_PCT", 80.0), number("COST_STOP_PCT", 95.0)
    pct = round(spend / budget * 100, 1) if budget > 0 else None
    level = "ok"
    if pct is not None:
        level = "stop" if pct >= stop else "warn" if pct >= warn else "ok"
    return {"month": month, "runs": len(recs), "spend_usd": round(spend, 4),
            "projection_usd": round(projection, 2), "budget_usd": budget or None,
            "pct_used": pct, "warn_pct": warn, "stop_pct": stop, "level": level,
            "essential": setting("COST_ESSENTIAL_MODES", "morning").split(), "records": recs}


def money(x):
    return f"${x:,.2f}"


def cmd_summary(_args):
    st = status()
    print(f"kit-cost: {st['month']} so far: {money(st['spend_usd'])} over {st['runs']} scheduled run(s); "
          f"projected {money(st['projection_usd'])} for the month")
    if st["budget_usd"]:
        print(f"Budget: {money(st['budget_usd'])}, {st['pct_used']}% used "
              f"(warn at {st['warn_pct']:g}%, stop at {st['stop_pct']:g}%): {st['level']}")
    else:
        print("Budget: not set (COST_BUDGET_MONTHLY in the config), so no run is ever skipped")
    top = sorted(st["records"], key=cost, reverse=True)[:5]
    if top:
        print("Costliest runs:")
        for r in top:
            secs = (r.get("duration_ms") or 0) // 1000
            detail = (f"{r.get('turns') or '?'} turns, {secs}s" if r.get("duration_ms") is not None
                      else f"{r.get('provider', '')}/{r.get('model', '?')}".lstrip("/"))
            print(f"  {r['date']}  {r.get('mode', '?'):<9} {money(cost(r))}  {detail}")
    models = by_model(st["records"])
    if models:
        print("By model: " + ", ".join(
            f"{m} {money(v['spend_usd'])}" + (f" (+{v['unpriced']} not priced)" if v["unpriced"] else "")
            for m, v in list(models.items())[:4]))
    print("Interactive sessions aren't counted; see them with /cost and /usage in Claude Code.")
    return 0


def cmd_report(args):
    month = args.month or today().strftime("%Y-%m")
    if not re.fullmatch(r"\d{4}-\d{2}", month):
        sys.exit("kit-cost: --month takes YYYY-MM")
    st = status(month)
    year, mon = (int(x) for x in month.split("-"))
    prev = f"{year - 1}-12" if mon == 1 else f"{year}-{mon - 1:02d}"
    prev_spend = sum(cost(r) for r in entries() if month_of(r) == prev)
    by_mode, by_day = {}, {}
    for r in st["records"]:
        m = r.get("mode", "?")
        by_mode.setdefault(m, [0, 0.0])
        by_mode[m][0] += 1
        by_mode[m][1] += cost(r)
        by_day[r["date"][:10]] = by_day.get(r["date"][:10], 0.0) + cost(r)
    change = (round((st["spend_usd"] - prev_spend) / prev_spend * 100, 1) if prev_spend else None)
    data = {k: v for k, v in st.items() if k != "records"}
    data.update({"previous_month": prev, "previous_spend_usd": round(prev_spend, 4),
                 "change_pct": change,
                 "by_mode": {m: {"runs": n, "spend_usd": round(c, 4)} for m, (n, c) in sorted(by_mode.items())},
                 "by_day": {d: round(c, 4) for d, c in sorted(by_day.items())},
                 "by_model": by_model(st["records"])})
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    show = {args.by} if args.by else {"mode", "day", "model"}
    print(f"kit-cost report: {month}: {money(st['spend_usd'])} over {st['runs']} run(s)")
    trend = "no runs recorded" if not prev_spend else f"{change:+.1f}%"
    print(f"Previous month ({prev}): {money(prev_spend)}; change {trend}")
    if "mode" in show:
        print("By run kind:")
        for m, v in data["by_mode"].items():
            print(f"  {m:<9} {v['runs']:>3} run(s)  {money(v['spend_usd'])}")
    if "day" in show:
        print("By day:")
        for d, c in data["by_day"].items():
            print(f"  {d}  {money(c)}")
    if "model" in show:
        print("By model:")
        for m, v in data["by_model"].items():
            extra = f"  ({v['unpriced']} not priced)" if v["unpriced"] else ""
            print(f"  {m:<28} {v['runs']:>3} use(s)  {money(v['spend_usd'])}{extra}")
    return 0


def cmd_check(args):
    st = status()
    code = {"ok": 0, "warn": 1, "stop": 2}[st["level"]]
    allowed = True
    if args.mode and st["level"] == "stop" and args.mode not in st["essential"]:
        allowed = False
    if args.json:
        out = {k: v for k, v in st.items() if k != "records"}
        out.update({"mode": args.mode, "allowed": allowed})
        print(json.dumps(out))
    else:
        pct = f"{st['pct_used']}%" if st["pct_used"] is not None else "no budget"
        verdict = "" if not args.mode else ("; this run may go ahead" if allowed else "; this run should skip")
        print(f"{st['level']} {pct}{verdict}")
    return code


def cmd_record(args):
    """Read one run's JSON output: text result to the log, one line to the ledger. Never fails hard."""
    raw = ""
    try:
        raw = pathlib.Path(args.json_file).read_text(errors="ignore")
    except OSError:
        pass
    log = open(args.log, "a") if args.log else sys.stdout
    data = None
    try:
        data = json.loads(raw)
        if not isinstance(data, dict):
            data = None
    except ValueError:
        # The last line may be the result when something printed before it.
        for line in reversed(raw.strip().splitlines()):
            try:
                cand = json.loads(line)
                if isinstance(cand, dict) and cand.get("type") == "result":
                    data = cand
                    break
            except ValueError:
                continue
    if data is None:
        log.write(raw if raw.endswith("\n") or not raw else raw + "\n")
        log.write("== kit-cost: run output wasn't JSON; no cost recorded\n")
        return 0
    text = data.get("result")
    if text is None and data.get("errors"):
        text = "\n".join(str(x) for x in data["errors"])
    log.write((text or "") + "\n")
    usage = data.get("usage") or {}
    rec = {"date": dt.datetime.now().isoformat(timespec="seconds"), "mode": args.mode, "rc": args.rc,
           "cost_usd": data.get("total_cost_usd"),
           "input_tokens": usage.get("input_tokens"), "output_tokens": usage.get("output_tokens"),
           "cache_read_tokens": usage.get("cache_read_input_tokens"),
           "cache_write_tokens": usage.get("cache_creation_input_tokens"),
           "duration_ms": data.get("duration_ms"), "turns": data.get("num_turns"),
           "subtype": data.get("subtype"), "is_error": data.get("is_error")}
    models = models_from(data)
    rec["models"] = models
    rec["model"] = primary_model(models)
    if os.environ.get("KIT_COST_TODAY"):
        rec["date"] = os.environ["KIT_COST_TODAY"] + "T00:00:00"
    try:
        append(rec)
        log.write(f"== kit-cost: {args.mode} run cost about ${cost(rec):.4f} ({rec['model']})\n")
    except OSError as e:
        log.write(f"== kit-cost: couldn't write the ledger ({e})\n")
    return 0


def append(rec):
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    new = not LEDGER.exists()
    with open(LEDGER, "a") as f:
        f.write(json.dumps(rec) + "\n")
    if new and os.name != "nt":
        os.chmod(LEDGER, 0o600)


def cmd_record_usage(args):
    """One line for model use outside Claude Code's own runs (kit-delegate, kit-run)."""
    c = args.cost
    rec = {"date": dt.datetime.now().isoformat(timespec="seconds"),
           "mode": args.mode or args.source, "source": args.source, "provider": args.provider,
           "model": args.model, "cost_usd": c, "input_tokens": args.input, "output_tokens": args.output,
           "models": {args.model: {"cost_usd": c, "input_tokens": args.input, "output_tokens": args.output,
                                   "provider": args.provider}}}
    if os.environ.get("KIT_COST_TODAY"):
        rec["date"] = os.environ["KIT_COST_TODAY"] + "T00:00:00"
    try:
        append(rec)
    except OSError as e:
        print(f"kit-cost: couldn't write the ledger ({e})", file=sys.stderr)
        return 1
    priced = f"${c:.4f}" if c is not None else "not priced"
    print(f"kit-cost: recorded {args.source} use of {args.provider}/{args.model}: {priced}")
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="kit-cost", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("report")
    r.add_argument("--month")
    r.add_argument("--json", action="store_true")
    r.add_argument("--by", choices=["mode", "day", "model"])
    c = sub.add_parser("check")
    c.add_argument("--mode")
    c.add_argument("--json", action="store_true")
    rec = sub.add_parser("record")
    rec.add_argument("--mode", required=True)
    rec.add_argument("--rc", type=int, default=0)
    rec.add_argument("--json-file", required=True)
    rec.add_argument("--log")
    ru = sub.add_parser("record-usage")
    ru.add_argument("--source", required=True, choices=["delegate", "kit-run"])
    ru.add_argument("--provider", required=True)
    ru.add_argument("--model", required=True)
    ru.add_argument("--input", type=int)
    ru.add_argument("--output", type=int)
    ru.add_argument("--cost", type=float)
    ru.add_argument("--mode")
    args = ap.parse_args(argv)
    handler = {"report": cmd_report, "check": cmd_check, "record": cmd_record,
               "record-usage": cmd_record_usage}.get(args.cmd, cmd_summary)
    return handler(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
