#!/usr/bin/env python3
"""kit-audit-export: build a dated evidence pack of Kit's controls for a compliance or security review.

  kit-audit-export [--from YYYY-MM-DD] [--to YYYY-MM-DD] [--out DIR] [--zip]

The pack (default: ~/Claude/Agents/kit-audit-export-<from>-to-<to>/, or DIR) holds:
  README.md                what's in the pack and how it was made
  MANIFEST.json            SHA-256 of every file in the pack
  audit/                   the connector guard's audit log lines in the date range (every call to an
                           outside system, allowed or denied, with its result)
  kit-audit/               kit-audit's latest status and summary, and the weekly audit report
  approvals/               phone approvals, kit-run's audit lines in the range, and the list of
                           messages sent between Kits (metadata only)
  config/                  connector-guard.json, sharing-policy.json, models.json's enabled_phase and
                           org_profile, and the permission lists from Claude Code's settings
  agents.json              every installed agent's tools, disallowedTools, and model
  version.txt              the installed Kit version and the newest CHANGELOG entries
  doctor.txt               the health check's report

Never included: memory/personal/, the briefs themselves, mail, library documents, environment
variables, or any value that looks like a credential. Before finishing, the whole pack is scanned for
credential-like text; if anything turns up, the pack is removed and nothing is left behind.
--zip also writes <pack>.zip next to the folder. The pack is readable only by you.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import zipfile

HOME = pathlib.Path.home()
KIT = pathlib.Path(os.path.expanduser(os.environ.get("KIT_DIR", "~/Claude/Agents/kit")))
CTX = KIT / "memory/context"
SHARED = pathlib.Path(__file__).resolve().parent.parent
for cand in (SHARED, KIT / ".install/shared"):
    if (cand / "kit_records.py").exists():
        sys.path.insert(0, str(cand))
        break
try:
    import kit_records
    _PATTERNS = kit_records.SECRET_PATTERNS
except ImportError:  # pragma: no cover
    _PATTERNS = []
# Credential-shaped patterns only; long digit runs (timestamps, ids) are reported, not refused.
CRED_PATTERNS = [(p, w) for p, w in _PATTERNS if w not in ("account or card number", "Social Security number")]


def cred_hits(text):
    return sorted({w for p, w in CRED_PATTERNS if re.search(p, text)})


def read_json(path):
    try:
        return json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def in_range(stamp, start, end):
    try:
        d = dt.date.fromisoformat(str(stamp)[:10])
    except ValueError:
        return False
    return start <= d <= end


def jsonl_lines(paths, start, end, key):
    out = []
    for p in sorted(paths):
        try:
            for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if in_range(rec.get(key, ""), start, end):
                    out.append(line)
        except OSError:
            continue
    return out


def frontmatter(path):
    text = path.read_text(encoding="utf-8", errors="replace")
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    fm = {}
    for line in text[3:end].splitlines():
        m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if m and not line.startswith(" "):
            fm[m.group(1)] = m.group(2).strip()
    return fm


def months(start, end):
    y, m = start.year, start.month
    while (y, m) <= (end.year, end.month):
        yield f"{y:04d}-{m:02d}"
        y, m = (y + 1, 1) if m == 12 else (y, m + 1)


def build(pack, start, end):
    notes = []
    def w(rel, text):
        (pack / rel).parent.mkdir(parents=True, exist_ok=True)
        (pack / rel).write_text(text, encoding="utf-8")


    guard = read_json(CTX / "connector-guard.json") or {}
    audit_dir = pathlib.Path(os.path.expanduser(guard.get("audit_dir") or str(KIT / "audit")))
    files = [audit_dir / f"connectors-{m}.jsonl" for m in months(start, end)]
    lines = jsonl_lines([f for f in files if f.exists()], start, end, "time")
    w("audit/connector-calls.jsonl", "\n".join(lines) + ("\n" if lines else ""))
    notes.append(f"Connector guard audit: {len(lines)} line(s) from {audit_dir}")

    for name in ("audit-status.json", "audit.txt", "audit-weekly.md"):
        src = KIT / "briefs" / name
        if src.exists():
            (pack / "kit-audit").mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, pack / "kit-audit" / name)
    reports = audit_dir / "reports"
    if reports.is_dir():
        for r in sorted(reports.glob("*.md")):
            if in_range(dt.datetime.fromtimestamp(r.stat().st_mtime).date().isoformat(), start, end):
                (pack / "kit-audit/reports").mkdir(parents=True, exist_ok=True)
                shutil.copy2(r, pack / "kit-audit/reports" / r.name)

    pa = KIT / "briefs/phone-approvals.md"
    if pa.exists():
        (pack / "approvals").mkdir(parents=True, exist_ok=True)
        shutil.copy2(pa, pack / "approvals/phone-approvals.md")
    kr = jsonl_lines((KIT / ".install/logs").glob("kit-run-*.jsonl"), start, end, "ts")
    w("approvals/kit-run-audit.jsonl", "\n".join(kr) + ("\n" if kr else ""))
    sent = []
    outbox = KIT / "outbox"
    sharing = (CTX / "sharing.md").read_text(encoding="utf-8", errors="replace") if (CTX / "sharing.md").exists() else ""
    m = re.search(r"\*\*Outbox:\*\*\s*`([^`]+)`", sharing)
    if m:
        outbox = pathlib.Path(os.path.expanduser(m.group(1)))
    for p in sorted(outbox.glob("**/drafts/sent/*.json")) if outbox.is_dir() else []:
        rec = read_json(p) or {}
        body = rec.get("body") if isinstance(rec.get("body"), dict) else rec
        when = rec.get("published_at") or rec.get("created") or dt.datetime.fromtimestamp(p.stat().st_mtime).isoformat()
        if in_range(when, start, end):
            sent.append({"file": p.name, "when": when, "to": body.get("to"), "subject": body.get("subject"),
                         "classification": body.get("classification") or rec.get("classification")})
    w("approvals/kit-team-sent.json", json.dumps(sent, indent=2) + "\n")

    if guard:
        w("config/connector-guard.json", json.dumps(guard, indent=2) + "\n")
    pol = read_json(CTX / "sharing-policy.json")
    if pol is not None:
        w("config/sharing-policy.json", json.dumps(pol, indent=2) + "\n")
    models = read_json(KIT / "models.json")
    if models is not None:
        w("config/models-policy.json", json.dumps({"enabled_phase": models.get("enabled_phase", 1),
                                                   "default_profile": models.get("default_profile"),
                                                   "org_profile": models.get("org_profile", {})}, indent=2) + "\n")
    settings = read_json(HOME / ".claude/settings.json") or {}
    perm = settings.get("permissions") or {}
    summary, dropped = {}, 0
    for k in ("allow", "ask", "deny"):
        vals = [v for v in perm.get(k, []) if isinstance(v, str)]
        keep = [v for v in vals if not cred_hits(v)]
        dropped += len(vals) - len(keep)
        summary[k] = keep
    if "defaultMode" in perm:
        summary["defaultMode"] = perm["defaultMode"]
    w("config/claude-permissions.json", json.dumps(summary, indent=2) + "\n")
    if dropped:
        notes.append(f"{dropped} permission entr(ies) left out because they looked like credentials")

    agents = []
    for p in sorted((HOME / ".claude/agents").glob("*.md")):
        fm = frontmatter(p)
        agents.append({"name": fm.get("name", p.stem), "tools": fm.get("tools", "(all)"),
                       "disallowedTools": fm.get("disallowedTools", ""), "model": fm.get("model", "inherit")})
    w("agents.json", json.dumps(agents, indent=2) + "\n")

    ver = read_json(KIT / ".install/VERSION.json") or {}
    text = f"Kit {ver.get('version', 'unknown')} ({str(ver.get('commit', 'unknown'))[:7]}), installed {ver.get('installed', 'unknown')}\n"
    ch = KIT / ".install/CHANGELOG.md"
    if ch.exists():
        sections = re.split(r"(?m)^## ", ch.read_text(encoding="utf-8", errors="replace"))
        text += "\n" + "\n".join("## " + s.rstrip() for s in sections[1:3]) + "\n"
    w("version.txt", text)

    doctor = KIT / ".install/shared/doctor.py"
    if doctor.exists():
        r = subprocess.run([sys.executable, str(doctor)], capture_output=True, text=True, timeout=180)
        w("doctor.txt", r.stdout + (r.stderr if r.returncode else ""))
    else:
        w("doctor.txt", "doctor.py isn't installed here.\n")
    return notes


def finish(pack, start, end, notes):
    readme = f"""# Kit evidence pack, {start} to {end}

Made {dt.datetime.now().astimezone().isoformat(timespec='seconds')} by kit-audit-export for a compliance or
security review. Every file is listed with its SHA-256 in MANIFEST.json.

- audit/connector-calls.jsonl: every call Kit's agents made to an outside system in the range, as
  the connector guard recorded it (allowed, denied, result, failure), with inputs already scrubbed.
- kit-audit/: kit-audit's latest status and summary, the weekly audit, and audit reports dated in
  the range.
- approvals/: phone approvals (accepted and refused), kit-run's audit lines, and the messages this
  Kit sent to other Kits (metadata only; every send needed the owner's yes at the keyboard).
- config/: the connector guard's settings, the sharing and model policies, and Claude Code's
  permission lists (allow, ask, deny).
- agents.json: each installed agent's tools, disallowed tools, and model.
- version.txt and doctor.txt: the installed version, recent changes, and the health check.

Not included, by design: personal notes, briefs, mail, library documents, environment variables, and
anything that looks like a credential. The pack was scanned for credential-like text before it was
finished.

Notes:
""" + "".join(f"- {n}\n" for n in notes)
    (pack / "README.md").write_text(readme, encoding="utf-8")
    manifest = {}
    for p in sorted(pack.rglob("*")):
        if p.is_file() and p.name != "MANIFEST.json":
            manifest[p.relative_to(pack).as_posix()] = hashlib.sha256(p.read_bytes()).hexdigest()
    (pack / "MANIFEST.json").write_text(json.dumps({"from": str(start), "to": str(end), "files": manifest},
                                                   indent=2) + "\n", encoding="utf-8")


def scan(pack):
    hits = []
    for p in sorted(pack.rglob("*")):
        if p.is_file():
            found = cred_hits(p.read_text(encoding="utf-8", errors="replace"))
            if found:
                hits.append(f"{p.relative_to(pack)}: {', '.join(found)}")
    return hits


def main(argv):
    ap = argparse.ArgumentParser(prog="kit-audit-export", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    today = dt.date.today()
    ap.add_argument("--from", dest="start", default=str(today - dt.timedelta(days=30)))
    ap.add_argument("--to", dest="end", default=str(today))
    ap.add_argument("--out", help="folder for the pack (must not exist yet)")
    ap.add_argument("--zip", action="store_true", help="also write <pack>.zip")
    a = ap.parse_args(argv)
    try:
        start, end = dt.date.fromisoformat(a.start), dt.date.fromisoformat(a.end)
    except ValueError:
        sys.exit("kit-audit-export: dates are YYYY-MM-DD")
    if start > end:
        sys.exit("kit-audit-export: --from is after --to")
    pack = pathlib.Path(os.path.expanduser(a.out)) if a.out else KIT.parent / f"kit-audit-export-{start}-to-{end}"
    if pack.exists():
        sys.exit(f"kit-audit-export: {pack} already exists; choose another --out")
    if pack.resolve() == KIT.resolve() or KIT.resolve() in pack.resolve().parents:
        sys.exit("kit-audit-export: put the pack outside Kit's folder")
    old = os.umask(0o077)
    try:
        pack.mkdir(parents=True)
        notes = build(pack, start, end)
        finish(pack, start, end, notes)
        hits = scan(pack)
        if hits:
            shutil.rmtree(pack)
            sys.exit("kit-audit-export: credential-like text turned up, so the pack was removed:\n  "
                     + "\n  ".join(hits))
        print(f"kit-audit-export: {pack} ({len(list(pack.rglob('*')))} entries), scanned clean")
        for n in notes:
            print("  " + n)
        if a.zip:
            z = pack.with_suffix(".zip") if pack.suffix == "" else pathlib.Path(str(pack) + ".zip")
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for p in sorted(pack.rglob("*")):
                    if p.is_file():
                        zf.write(p, p.relative_to(pack.parent).as_posix())
            print(f"kit-audit-export: {z}")
    finally:
        os.umask(old)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
