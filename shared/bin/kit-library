LIBRARY = KIT / "library"
CONFIG = LIBRARY / "collections.json"
STATE = KIT / ".install" / "library"
DB = STATE / "index.db"
OUTBOX = STATE / "outbox"
LOCK = STATE / "index.lock"
DELIVERED = STATE / "delivered.log"
LOG = KIT / ".install" / "logs" / "library.log"
MACLIB = pathlib.Path(__file__).resolve().parent.parent.parent / "platform" / "mac" / "library"
APP = pathlib.Path(os.environ.get("KIT_LIBRARY_APP", MACLIB / "KitLibrary.app"))
PDFTEXT = pathlib.Path(os.environ.get("KIT_PDFTEXT", MACLIB / "kit-pdftext"))
IN_APP = os.environ.get("KIT_LIBRARY_IN_APP") == "1"
APP_COMMANDS = {"index", "flush", "mirror", "fetch", "--check"}
SEND = OUTBOX.parent / "send"                 # copies made for "kit send" (cleared after a day)
MAX_SEND = 30 * 1024 * 1024
MAX_CHARS = 600_000
TOOL_PATH = f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

DEFAULT_KINDS = {"letters": "Letters", "preaching": "Sermon Prep", "content": "Content", "receipts": "Receipts",
