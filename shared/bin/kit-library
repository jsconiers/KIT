#!/usr/bin/env python3
"""kit-library: catalog folders of your documents (collections, scanned PDFs included), tag them, search them; and Kit Output.

  kit-library                          status: collections, how many documents, when last indexed
  kit-library collections              each collection: its folders, what it holds, its tags and rules
  kit-library add NAME FOLDER [--label L] [--about TEXT] [--tag T,...] [--scripture] [--images]
                                       a new collection, or one more folder for an existing one
  kit-library remove NAME [FOLDER]     stop cataloging a collection (or one of its folders); the files
                                       themselves are never touched
  kit-library about NAME "TEXT"        say what a collection holds
  kit-library tag NAME TAG[,TAG]       tag every document in a collection (untag NAME TAG undoes it)
  kit-library rule NAME PATTERN TAG[,TAG]
                                       tag the documents in a collection whose path inside it matches
                                       PATTERN: a glob ("*40 Day*") or plain words ("devotional")
  kit-library rules NAME               a collection's rules, numbered (unrule NAME N removes one)
  kit-library exclude NAME PATTERN     leave matching files and folders out (include NAME PATTERN undoes)
  kit-library define TAG "MEANING"     say what a tag means
  kit-library tags                     every tag, what it means, how many documents carry it
  kit-library index [NAME ...] [--full] [--max-minutes N] [--quiet]
                                       catalog new and changed files (--full reads every file again)
  kit-library search WORDS [--in NAME] [--tag T] [--type pdf] [--ref "John 3:16"] [--year 2024]
                     [--limit 10] [--json]
                                       find documents. WORDS may use "quoted phrases", OR, and word*;
                                       --ref finds the documents that cite a passage (scripture
                                       collections), with or without WORDS
  kit-library show ID [--text] [--chars N] [--json]
                                       one document: where it is, its tags, the passages it cites;
                                       --text adds its text from the catalog (so agents can read Word
                                       and PowerPoint files); --chars caps it (default 20000, 0 = all)
  kit-library recent [--days 14] [--in NAME] [--json]
  kit-library output [KIND] [--json]   the output folder (Kit Output), or the folder for one kind
  kit-library deliver FILE... [--kind KIND] [--sub FOLDER] [--name NAME] [--replace] [--no-date]
                      [--as-md] [--keep-md]
                                       put finished work in the output folder and catalog it there.
                                       Markdown becomes a Word file (--as-md keeps it markdown,
                                       --keep-md delivers both); names start with the date unless
                                       --no-date; an existing file is never overwritten unless --replace
  kit-library mirror                   copy Kit Output one way to the synced folder in output.mirror (an
                                       iCloud Drive folder, say): new and changed files only, never deletes;
                                       every delivery does this on its own
  kit-library fetch ID [--to-phone] [--json]
                                       stage a cataloged file for sending (texting Kit uses this); --to-phone
                                       also puts a copy in the mirror's "Sent to phone" folder
  kit-library --check                  one line for kit doctor

Collections and tags are in ~/Claude/Agents/kit/library/collections.json (change them with the
commands above, or edit it). The catalog, with each document's text, is .install/library/index.db: it
is rebuilt from the folders, readable only by you, and never committed or backed up. Long runs of
digits (account, card, and ID numbers) are blanked out of the stored text, so they can't surface in
a search, a brief, or a text.

kit-library only reads the folders it catalogs. It never changes, moves, renames, or deletes anything
in them; the one place it writes is the output folder, and there only through deliver. On a Mac,
folders like Documents need permission: when a scheduled job can't read or write them, kit-library
hands the work to KitLibrary.app, which holds that permission and runs only index, flush (deliveries
waiting in .install/library/outbox), mirror, fetch, and check.

Text formats: Word (.docx, .doc), RTF, OpenDocument, PowerPoint (.pptx; .ppt roughly), Excel (.xlsx),
PDF (through kit-pdftext, a small PDFKit tool built with the Mac platform files; scanned PDFs are read
with on-device OCR, up to ocr.max_pages pages each, when ocr.pdf is on), web pages, EPUB,
plain text and markdown, and Scrivener projects. Pages, Keynote, audio, and video are cataloged by
name, folder, and date. Pictures are left out unless a collection says --images.
"""
import datetime as dt
import fcntl
import fnmatch
import html
import json
import os
import pathlib
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import uuid
import zipfile

HOME = pathlib.Path.home()
